-- Synfide example · an onboarding service with a human approval in the middle.
--
--   synsema serve example_onboarding.syn
--
--   # 1. start (or advance) an onboarding — it parks at the approval step:
--   curl -X POST localhost:8080/onboarding/ana/start
--   # 2. see what's waiting for a human:
--   curl localhost:8080/inbox
--   # 3. the human decides (from anywhere — this route, a bot, a CLI):
--   curl -X POST localhost:8080/inbox/onboarding-ana \
--        -d '{"approved": true, "who": "joel"}'
--   # 4. nothing else to do: the heartbeat (cron, every 15s) re-runs parked
--   #    workflows, so the onboarding finishes BY ITSELF. (POST …/start still
--   #    works if you want to advance it immediately.)
--   curl localhost:8080/onboarding/ana        # → watch it reach "done"
--   # …and the whole thing survives a server restart at any point in between.
intent: "Onboard employees with a durable workflow parked on human approval"

require memory("synfide-onboarding-demo")
require serve(8080)
require stdout
require time
require secret

use "./synfide/durable.syn" as durable
use "./synfide/approvals.syn" as approvals
use "./synfide/ui.syn" as ui
use "./synfide/agent.syn" as agent

task prepare(ctx)
    give "account drafted for " + ctx["employee"]

task approval(ctx)
    give approvals.gate("onboarding-" + ctx["employee"], "Approve onboarding of " + ctx["employee"] + "?")

task activate(ctx)
    give "activated " + ctx["employee"]

task wf_steps()
    give [
        {"name": "prepare", "run": prepare},
        {"name": "approval", "run": approval},
        {"name": "activate", "run": activate}
    ]

task wf_name(employee)
    give "onboarding-" + employee

-- The OPINIONATED demo of the agent chat lives HERE (an example), not in the
-- neutral scaffold: ask the chat "onboard ana" / "how is ana going?".
task tool_start_onboarding(name)
    require memory("synfide-onboarding-demo")
    require time
    let r be durable.run(wf_name(name), wf_steps(), {"employee": name})
    when r["status"] == "waiting"
        give "onboarding of " + name + " started — WAITING for human approval in /inbox/ui; it finishes by itself once approved"
    give "onboarding of " + name + ": " + r["status"]

task tool_check_onboarding(name)
    require memory("synfide-onboarding-demo")
    let s be durable.status_of(wf_name(name))
    give wf_name(name) + " → next: " + text(s["next"]) + ". " + text(s["display"])

let TOOLS be {"start_onboarding": tool_start_onboarding, "check_onboarding": tool_check_onboarding}
let CATALOG be [
    {"name": "start_onboarding", "describe": "Start an onboarding workflow for a person. Requires human approval in the inbox.", "params": ["name"]},
    {"name": "check_onboarding", "describe": "Check how a person's onboarding is going.", "params": ["name"]}
]

task chat_agent(message, history)
    give agent.respond(message, TOOLS, CATALOG, history, 4)

-- The re-entry heartbeat: every parked onboarding advances by itself as soon
-- as its approval lands — no second POST needed.
task heartbeat()
    let woken be durable.tick([{"prefix": "onboarding-", "steps": wf_steps()}])
    when length(woken) > 0
        log "heartbeat woke: " + json_encode(woken)

cron_every(15, heartbeat)

let DEMO_CONFIG be {
    "open": true,
    "responder": chat_agent,
    "about": "Synfide demo — onboarding with a human approval in the middle",
    "api_docs": ["POST /onboarding/:employee/start — start (or advance) an onboarding.\n  curl -X POST localhost:8080/onboarding/ana/start", "GET /onboarding/:employee — where it stands.\n  curl localhost:8080/onboarding/ana", "GET /inbox — approvals waiting for a human.\n  curl localhost:8080/inbox", "POST /inbox/:id — decide one.\n  curl -X POST localhost:8080/inbox/onboarding-ana -H 'Content-Type: application/json' -d '{\"approved\":true,\"who\":\"joel\"}'"]
}

serve on 8080
    static "/synfide-ui" from "./synfide/ui/static"

    route "POST /onboarding/:employee/start"
        log "onboarding run: " + params.employee
        give durable.run(wf_name(params.employee), wf_steps(), {"employee": params.employee})

    route "GET /onboarding/:employee"
        give durable.status_of(wf_name(params.employee))

    -- the framework surface (admin, chat, inbox, api) via the dispatcher
    route "GET /"
        give ui.admin_get("", request, query, DEMO_CONFIG)

    route "GET /*path"
        give ui.admin_get(params.path, request, query, DEMO_CONFIG)

    route "POST /*path"
        give ui.admin_post(params.path, request, DEMO_CONFIG)
