-- Your Synfide SERVER — this file is YOURS, and it holds only what is yours:
-- the capabilities you grant, your domain (tools, executor, instructions) and
-- your own routes. The WHOLE admin surface (dashboard, chat, approvals inbox,
-- workflows, patches, journal, environment, endpoints, login/first-run) is
-- framework-owned and serves itself through three catch-all routes at the
-- bottom — framework upgrades bring new pages and fixes WITHOUT ever touching
-- this file again.
--
--   synsema serve serve.syn        →  http://localhost:8080
--   (first visit: /setup — the setup code prints on THIS terminal)
--
-- Everything between the ══ REPLACE ME ══ markers is a placeholder for your
-- domain. Opinionated, ready-to-run demos: https://github.com/kitecosmic/synfide
intent: "Agent chat + approval inbox + durable actions — wire your domain here"

require memory("my-synfide-app")
require serve(8080)
require stdout
require time
require llm
require net("docs.synsema.com")
require secret
require random
require file("./.env")
require file.read("./.env.example")
require file.read("./synfide/ui/static/*")
require file.read(".")                       -- root dir NODE only (names, no contents): the upgrade banner lists *.new files
require file("./workspace/*")                -- the agent's WHOLE territory: patches apply here (after audit + YOUR approval). workspace/site/ serves at /site; workspace/backend.syn RUNS in app_server.syn
require file.read("./workspace")             -- the dir NODE: grep/list_dir over the territory (search_workspace, list_workspace)
require net("127.0.0.1")                     -- the edge: /api/* proxies to the app server (and try_backend probes it)
require exec("synsema")                      -- the agent restarts/reads logs of the app server: synsema daemon restart/logs app_server.syn

use "./synfide/store.syn" as store
use "./synfide/durable.syn" as durable
use "./synfide/approvals.syn" as approvals
use "./synfide/ui.syn" as ui
use "./synfide/agent.syn" as agent
use "./synfide/journal.syn" as journal

-- ══════════════════ REPLACE ME: your executor ══════════════════
-- Runs AFTER a human approves an action. Put your real code here: call your
-- API (require net(...) in this task), send the email, move the money
-- (synfide/treasury.syn). Until then it only records that it would have run.
task execute_action(ctx)
    give "executed: \"" + ctx["title"] + "\" — (placeholder: put YOUR real code in execute_action(), serve.syn)"

task gate_action(ctx)
    give approvals.gate("action-" + ctx["id"], ctx["title"])

task action_steps()
    give [
        {"name": "approval", "run": gate_action},
        {"name": "execute", "run": execute_action}
    ]

-- ══════════════════ REPLACE ME: your tools ══════════════════
task tool_propose_action(title)
    require memory("my-synfide-app")
    require time
    let id be text(store.put("action-n", store.get("action-n", 0) + 1))
    let r be durable.run("action-" + id, action_steps(), {"id": id, "title": title})
    give "action-" + id + " (\"" + title + "\") is PARKED in the approval inbox (/inbox/ui). It will execute by itself once a human approves — status now: " + r["status"]

-- One action, one line — including WHAT the executor actually did once it
-- ran, so "approved but nothing visible happened" can't stay a mystery: the
-- placeholder executor SAYS it is a placeholder, right here.
task describe_action(w)
    let s be w["name"] + ": " + w["status"]
    when w["status"] == "done"
        let ctx be durable.status_of(w["name"])["ctx"]
        when ctx != nothing
            when contains(ctx, "execute")
                set s to s + " — result: " + text(ctx["execute"])
    give s

task tool_list_actions()
    require memory("my-synfide-app")
    let ws be durable.workflows("action-")
    when length(ws) == 0
        give "no actions proposed yet"
    give join(apply(ws, (w) => describe_action(w)), "\n")

-- ══ the agent's HANDS: real file patches under ./workspace (audited + human-approved) ══
-- Thin wrappers ON PURPOSE: the flow (propose → LLM audit → your inbox →
-- auto-apply) lives in synfide/agent.syn and updates with the framework;
-- what lives HERE is the POWER — the capability declarations that call_tool
-- enforces per-tool. Widen the file scope only deliberately (and patches
-- can never touch synfide/, no matter the scope).
task tool_propose_patch(path, old, new, why)
    require memory("my-synfide-app")
    require time
    require llm
    give agent.patch_flow(path, old, new, why, "only files under workspace/ — reject anything touching serve.syn, app_server.syn (capability grants are typed by humans), .env, credentials or synfide/. In workspace/backend.syn scrutinize every `require` line: reject file scopes reaching .env or credentials, reject net hosts unrelated to the change's stated purpose, reject exec entirely.")

task tool_list_patches()
    require memory("my-synfide-app")
    give agent.patches_summary()

-- Read whole files or SECTIONS (from = 1-based line, lines = how many) —
-- a big file never needs to flood the agent's context to be edited.
task tool_read_project_file(path, from = 0, lines = 0)
    require file.read("./workspace/*")
    when not file_exists(path)
        give "no such file: " + path
    when from > 0
        when lines > 0
            give read_file(path, from, lines)
        give read_file(path, from)
    give read_file(path)

-- Search the WHOLE territory (recursive, literal): file:line: text.
task tool_search_workspace(pattern)
    require file.read("./workspace")
    require file.read("./workspace/*")
    let g be grep("./workspace", text(pattern), {"max_results": 40})
    when length(g["matches"]) == 0
        give "no matches for: " + text(pattern)
    let s be join(apply(g["matches"], (m) => text(m["file"]) + ":" + text(m["line"]) + ": " + text(m["text"])), "\n")
    when g["truncated"]
        set s to s + "\n… (truncated at 40 matches — narrow the pattern)"
    give s

task workspace_tree(dir, prefix)
    let out be []
    each e in list_dir(dir)
        when e["is_dir"]
            set out to out + workspace_tree(dir + "/" + e["name"], prefix + e["name"] + "/")
        otherwise
            set out to out + [prefix + e["name"]]
    give out

task tool_list_workspace()
    require file.read("./workspace")
    require file.read("./workspace/*")
    try
        let files be workspace_tree("./workspace", "workspace/")
        when length(files) == 0
            give "workspace/ is empty — nothing built yet"
        give join(files, "\n")
    recover err
        give "workspace/ is empty or missing — nothing built yet (" + text(err) + ")"

-- ══ the agent's EYES: what got served, what actually happened ══
task tool_preview_page(path)
    require file.read("./workspace/site/*")
    give ui.preview_file("./workspace/site", path)

-- ══ the agent's HANDS ON THE APP SERVER: probe, restart, read the logs ══
-- The backend runs in its OWN process (app_server.syn, port 9000, under
-- `synsema daemon`) so it can die without taking the agent down. These three
-- tools close the self-healing loop: try it → restart it → when it will not
-- even boot, read its logs, patch the fix, restart again.
task tool_try_backend(method, path, body)
    require net("127.0.0.1")
    require time
    let url be "http://127.0.0.1:9000/api"
    when text(path) != ""
        set url to url + "/" + text(path)
    try
        let r be nothing
        when text(method) == "POST"
            set r to fetch(url, "POST", {"Content-Type": "application/json"}, json_encode(body))
        otherwise
            set r to fetch(url, "GET")
        give "HTTP " + text(r["status"]) + " — " + slice(text(r["body"]), 0, 3000)
    recover err
        give "backend UNREACHABLE (" + text(err) + ") — down or restarting: run restart_backend; if it will not start, read backend_logs"

task tool_restart_backend()
    require exec("synsema")
    require memory("my-synfide-app")
    require time
    -- stop + start, NOT `daemon restart`: restart re-spawns but does not
    -- detach back to the caller on Windows (it hangs). stop is idempotent —
    -- a non-zero exit (already stopped / never started) is fine.
    try
        run("synsema", ["daemon", "stop", "app_server.syn"], 30)
    recover err
        log "backend stop: " + text(err)
    let r be run("synsema", ["daemon", "start", "app_server.syn"], 60)
    when r["exit_code"] == 0
        store.del("synfide-syn-applied")
        give "backend (re)started: " + trim(text(r["stdout"])) + " — now PROVE your endpoints with try_backend (a boot crash would show as UNREACHABLE: then read backend_logs)"
    give "backend did NOT start (exit " + text(r["exit_code"]) + "): " + trim(text(r["stderr"])) + " — read backend_logs, find the error, patch the fix, restart again"

task tool_backend_logs()
    require exec("synsema")
    let r be run("synsema", ["daemon", "logs", "app_server.syn"], 30)
    let out be text(r["stdout"]) + text(r["stderr"])
    when length(out) > 4000
        give "…" + slice(out, length(out) - 4000, length(out))
    when trim(out) == ""
        give "no logs yet — the app server may never have started: run restart_backend"
    give out

task tool_journal_tail()
    require memory("my-synfide-app")
    give journal.tail(30)

let TOOLS be {
    "propose_action": tool_propose_action,
    "list_actions": tool_list_actions,
    "propose_patch": tool_propose_patch,
    "list_patches": tool_list_patches,
    "read_project_file": tool_read_project_file,
    "search_workspace": tool_search_workspace,
    "list_workspace": tool_list_workspace,
    "preview_page": tool_preview_page,
    "journal_tail": tool_journal_tail,
    "try_backend": tool_try_backend,
    "restart_backend": tool_restart_backend,
    "backend_logs": tool_backend_logs
}
let CATALOG be [
    {"name": "propose_patch", "describe": "Create or edit ONE real file of this app inside workspace/ — YOUR territory: web pages under workspace/site/ (served live at /site), backend code in workspace/backend.syn (its handle() serves /api/*), and any other folder you need (data, drafts — private, never served). `path` like \"workspace/site/index.html\" or \"workspace/backend.syn\"; `old` = exact unique text to replace (empty for CREATE a new file); `new` = the content; `why` = one line. The patch is auto-audited and then waits for the human in their Approvals inbox — approved patches apply to disk BY THEMSELVES (.syn code additionally needs a server restart to load). This is how you build: never paste project code into the chat instead of patching it. Verify Synsema code with synsema_verify FIRST.", "params": ["path", "old", "new", "why"]},
    {"name": "read_project_file", "describe": "Read a workspace file. Whole file by default; for BIG files pass `from` (1-based first line) and `lines` (how many) to read just a section. ALWAYS read before EDITING so `old` matches the current text exactly.", "params": ["path", "from", "lines"]},
    {"name": "search_workspace", "describe": "Find text across EVERY workspace file (recursive, literal match): returns file:line: text. Use it to locate where something lives before reading or patching — never guess a location.", "params": ["pattern"]},
    {"name": "list_workspace", "describe": "Every file in workspace/, one path per line — your map of the territory. Check it when you don't know what already exists.", "params": []},
    {"name": "try_backend", "describe": "Call your OWN backend (the app server): `method` GET or POST, `path` like \"ping\", `body` = JSON map or empty. ALWAYS prove an endpoint works with this after restart_backend. UNREACHABLE means the app server is down — restart_backend, then backend_logs if it will not come up.", "params": ["method", "path", "body"]},
    {"name": "restart_backend", "describe": "Restart (or first-start) the app server that runs workspace/backend.syn. Call it YOURSELF right after a backend patch applies — .syn code loads at boot, and the restart touches ONLY the app server, never this control plane. Then prove the change with try_backend.", "params": []},
    {"name": "backend_logs", "describe": "The app server's own logs. When restart_backend reports it did not start, the boot error is HERE — read it, patch the fix in workspace/backend.syn, restart again. You repair your own crashes; nobody external is needed.", "params": []},
    {"name": "list_patches", "describe": "Every file patch and its status (audited-ok/waiting/applied/rejected + why). Check it to know what the human approved instead of asking them.", "params": []},
    {"name": "preview_page", "describe": "See EXACTLY what /site serves for a path under workspace/site/ (\"\" = the homepage, \"style.css\", \"productos.html\"...). ALWAYS check your work with this after patches apply — a 404 here means the file is missing, truncated output still means the full file serves fine.", "params": ["path"]},
    {"name": "journal_tail", "describe": "The last 30 events of this app's journal: patches applied or failed, tool dispatches, approvals, errors. Your first stop when something seems off or when the human says something didn't work.", "params": []},
    {"name": "propose_action", "describe": "Queue an EXTERNAL action (send something, call an API, a payment...) for execution. A human approves it in their inbox and then it executes. `title` = short imperative description. For building/editing this app's files use propose_patch, NOT this.", "params": ["title"]},
    {"name": "list_actions", "describe": "List every queued action, its status and its actual result once executed.", "params": []}
]

-- ══ REPLACE ME: your agent's standing instructions (its 'system prompt') ══
let INSTRUCTIONS be "You are this app's operator agent. workspace/ is YOUR territory — build in real files there via propose_patch: pages under workspace/site/ serve live at /site the moment the human approves; REAL BACKEND ENDPOINTS live in workspace/backend.syn, whose handle() serves /api/* from its OWN process (the app server); anything else you keep in workspace/ (data, notes) is private, never served. Grow it all with patches. The `require` lines at the top of handle() are capability REQUESTS: the human reviews them in your diff, and they only work once the human also adds the grant in app_server.syn (say so when you request one). Your backend lifecycle is YOURS: after a backend patch applies, call restart_backend yourself (it touches only the app server, never you), then PROVE the endpoint with try_backend; if the app server will not boot, read backend_logs, patch the fix, restart again — you repair your own crashes. Know your territory: list_workspace maps it, search_workspace finds where things live, read_project_file reads whole files or sections — never guess what exists. After site patches, CHECK with preview_page; journal_tail shows what happened. For EXTERNAL side effects (emails, payments) use propose_action — honest note: its executor starts as a placeholder that only records (list_actions shows each result) until a human wires real code into execute_action."

-- agent.operator = YOUR domain (above) + the framework's baseline: the
-- Synsema docs/sandbox tools, the autonomy rules ("build it NOW, report what
-- you DID") and — because propose_patch is wired — the patching discipline.
-- The baseline updates with the framework; replace TOOLS/CATALOG freely —
-- the agent never unlearns the language. (Docs tools ride the
-- `require net("docs.synsema.com")` cap above.)
task chat_agent(message, history)
    give agent.operator(message, TOOLS, CATALOG, INSTRUCTIONS, history)

task heartbeat()
    let woken be durable.tick([{"prefix": "action-", "steps": action_steps()}, {"prefix": "patch-", "steps": agent.patch_steps()}])
    -- log only what MOVED: a parked action re-waiting every tick is not news
    -- (it used to flood the terminal once anything sat in the inbox)
    let moved be where(woken, (w) => w["status"] != "waiting")
    when length(moved) > 0
        log "heartbeat: " + json_encode(moved)

cron_every(15, heartbeat)

when not ui.users_exist()
    log "FIRST RUN: open http://localhost:8080/setup — the setup code will print HERE when you do."
    log "backend: `synsema daemon start app_server.syn` starts the /api process (or ask the agent — it has restart_backend)."

-- ══ REPLACE ME: your policy for the framework surface ══
-- All keys optional. api_docs feeds /admin/endpoints and /llms.txt — extend it
-- as you add routes. Budgets, coded approvals, self-improvement (patches):
-- mechanisms live in synfide/, wiring recipes in synfide/GUIDE.md.
let CONFIG be {
    "responder": chat_agent,
    "env_editable": true,
    "about": "Synfide app — agent chat, human approval inbox, durable actions",
    "api_docs": [
        "GET /site — the agent-built site (real files under ./workspace/site, written by audited + approved patches).",
        "GET|POST /api/* — the agent-built BACKEND (workspace/backend.syn in its own app server process; this edge proxies it).\n  curl localhost:8080/api/ping",
        "GET /chat/send?message=... — ask the agent (it can patch files and queue actions); then GET /chat shows the reply.\n  curl -L 'localhost:8080/chat/send?message=hello'",
        "GET /inbox — approvals waiting for a human, as JSON (session or Bearer SYNFIDE_ADMIN_TOKEN).\n  curl localhost:8080/inbox -H 'Authorization: Bearer <SYNFIDE_ADMIN_TOKEN>'",
        "POST /inbox/:id — decide one.\n  curl -X POST localhost:8080/inbox/<id> -H 'Authorization: Bearer <SYNFIDE_ADMIN_TOKEN>' -H 'Content-Type: application/json' -d '{\"approved\":true,\"who\":\"me\"}'",
        "GET /actions — every queued action and its status.\n  curl localhost:8080/actions -H 'Authorization: Bearer <SYNFIDE_ADMIN_TOKEN>'"
    ]
}

task app_auth(token, request)
    give ui.authenticate(token, request)

-- ══════════════════ routes ══════════════════
-- Your routes go FIRST (specificity wins over the catch-alls). The last three
-- routes serve the ENTIRE framework surface, now and in future releases.
serve on 8080
    auth with app_auth
    rate_limit 120 per minute

    -- ══ REPLACE ME: your domain routes ══
    route "GET /actions" requires auth
        give durable.workflows("action-")

    -- the agent-built site: files under ./workspace/site, created by
    -- approved patches, live here the moment they land (specificity beats
    -- the catch-alls). Only that SUBTREE is public — the rest of workspace/
    -- (backend code, data) is never served.
    route "GET /site"
        give ui.static_file("./workspace/site", "")

    route "GET /site/*path"
        give ui.static_file("./workspace/site", params.path)

    -- the agent-built BACKEND runs in its OWN process (app_server.syn, port
    -- 9000, under `synsema daemon`): it can crash and restart without ever
    -- touching this control plane. This edge proxies it — app server down →
    -- /api answers the proxy error while the agent (alive HERE) reads
    -- backend_logs and patches the fix itself.
    route "GET /api"
        proxy to "http://127.0.0.1:9000"

    route "GET /api/*path"
        proxy to "http://127.0.0.1:9000"

    route "POST /api/*path"
        rate_limit 60 per minute
        proxy to "http://127.0.0.1:9000"

    -- ── the framework surface (leave these three alone) ──
    route "GET /"
        give ui.admin_get("", request, query, CONFIG)

    route "GET /*path"
        give ui.admin_get(params.path, request, query, CONFIG)

    route "POST /*path"
        rate_limit 12 per minute
        give ui.admin_post(params.path, request, CONFIG)
