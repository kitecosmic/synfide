-- Your Synfide SERVER — neutral wiring, no domain baked in:
--
--   synsema serve serve.syn
--
--   http://localhost:8080          → home
--   http://localhost:8080/chat     → an AGENT chat: ask it to do ANYTHING
--                                    ("prepare the monthly report", "renew the
--                                    certs", …). It PROPOSES the action, which
--                                    parks in your approval inbox; once a human
--                                    approves, execute_action() runs it.
--   http://localhost:8080/inbox/ui → the approval inbox (works on a phone)
--
-- The framework part is generic (synfide/ packages). YOUR app is this file:
-- everything between the ══ REPLACE ME ══ markers is a placeholder for your
-- domain — your tools, your executor, your routes. Opinionated, ready-to-run
-- demos live in the repo's examples/, not here:
--   https://github.com/kitecosmic/synfide
intent: "Agent chat + approval inbox + durable actions — wire your domain here"

require memory("my-synfide-app")
require serve(8080)
require stdout
require time
require llm

use "./synfide/store.syn" as store
use "./synfide/durable.syn" as durable
use "./synfide/approvals.syn" as approvals
use "./synfide/ui.syn" as ui
use "./synfide/agent.syn" as agent

-- ══════════════════ REPLACE ME: your executor ══════════════════
-- This runs AFTER a human approves an action. Put your real code here: call
-- your API (require net(...) in this task), send the email, move the money
-- (synfide/treasury.syn), restart the service. Until you do, it only records
-- that it would have run.
task execute_action(ctx)
    give "executed: \"" + ctx["title"] + "\" — (placeholder: put YOUR real code in execute_action(), serve.syn)"

task gate_action(ctx)
    give approvals.gate("action-" + ctx["id"], ctx["title"])

task action_steps()
    give [
        {"name": "approval", "run": gate_action},
        {"name": "execute", "run": execute_action}
    ]

-- ══════════════════ REPLACE ME: your tools ══════════════════
-- The two below are DOMAIN-FREE on purpose: propose_action lets the agent turn
-- ANY request into an approval-gated durable action; list_actions reports.
-- Replace or extend them with tools that speak your business.

task tool_propose_action(title)
    require memory("my-synfide-app")
    require time
    let id be text(store.put("action-n", store.get("action-n", 0) + 1))
    let r be durable.run("action-" + id, action_steps(), {"id": id, "title": title})
    give "action-" + id + " (\"" + title + "\") is PARKED in the approval inbox (/inbox/ui). It will execute by itself once a human approves — status now: " + r["status"]

task tool_list_actions()
    require memory("my-synfide-app")
    let ws be durable.workflows("action-")
    when length(ws) == 0
        give "no actions proposed yet"
    give join(apply(ws, (w) => w["name"] + ": " + w["status"]), " · ")

let TOOLS be {
    "propose_action": tool_propose_action,
    "list_actions": tool_list_actions
}
let CATALOG be [
    {"name": "propose_action", "describe": "Queue an action for execution. ALWAYS call this when the user asks you to do, change, fix or run ANYTHING — never refuse for lack of access: this tool IS your access. A human approves it in their inbox and then it executes. `title` = short imperative description of the action.", "params": ["title"]},
    {"name": "list_actions", "describe": "List every queued action and its current status (waiting/done/failed). Call it whenever the user asks what is pending or how things are going.", "params": []}
]

-- ══ REPLACE ME: your agent's standing instructions (its 'system prompt') ══
let INSTRUCTIONS be "You are this app's operator agent. You DO have the ability to act: whenever the user asks you to do/change/fix/run something, call propose_action with a short title — the human approves it in their inbox and it then executes automatically. Never claim you lack access. Answer briefly."

task chat_agent(message, history)
    give agent.respond(message, TOOLS, CATALOG, INSTRUCTIONS + "\n--- conversation so far ---\n" + history, 4)

task heartbeat()
    let woken be durable.tick([{"prefix": "action-", "steps": action_steps()}])
    when length(woken) > 0
        log "heartbeat woke: " + json_encode(woken)

cron_every(15, heartbeat)

-- ══ REPLACE ME: security & per-user budgets (mechanisms ready, policy is YOURS) ══
-- · Who may approve: add `requires auth` to the /inbox routes (see the server
--   docs) — or protect an approval so it can be decided from ANY channel with a
--   one-time code: `let code be approvals.protect(id)` (needs `require random`),
--   send the code by Telegram/WhatsApp/SMS, resolve with
--   `approvals.resolve_coded(id, true, who, code)`.
-- · Per-user token budgets (a customer must not burn 30k tokens insisting):
--       use "./synfide/limits.syn" as limits
--       let before be llm_usage()
--       when not limits.within("user:" + user_id, 30000)
--           give my_over_budget_reply()   -- deny, hand to a human, queue: YOUR call
--       …answer…
--       limits.charge("user:" + user_id, llm_usage() - before)

-- ══════════════════ routes (add your own below) ══════════════════
serve on 8080
    route "GET /"
        give html(ui.home_page())

    route "GET /chat"
        give html(ui.chat_page())

    route "GET /chat/send"
        give ui.chat_send_with(query.message, chat_agent)

    route "GET /inbox"
        give approvals.pending()

    route "GET /inbox/ui"
        give html(ui.inbox_page())

    route "GET /inbox/ui/decide"
        give ui.resolve(query.id, query.approved, query.who)

    route "POST /inbox/:id"
        let b be json of request
        when b == nothing
            give fail("body must be JSON: {\"approved\": true|false, \"who\": \"name\"}")
        let d be approvals.resolve(params.id, b["approved"], b["who"])
        when d == nothing
            give not_found("no such approval: " + params.id)
        give d

    route "GET /actions"
        give durable.workflows("action-")
