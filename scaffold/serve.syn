-- Your Synfide SERVER: chat + approval inbox + a durable demo workflow, all in
-- one process. This is the file the console and the browser talk to.
--
--   synsema serve serve.syn
--
--   http://localhost:8080          → home (links to everything)
--   http://localhost:8080/chat     → an AGENT chat: it can DO things. Try
--                                    "onboard ana" — it starts a durable
--                                    workflow that parks in your inbox; approve
--                                    it and the heartbeat finishes the job.
--   http://localhost:8080/inbox/ui → the approval inbox (works on a phone)
--
--   # start a demo workflow that parks on a human approval:
--   curl -X POST localhost:8080/demo/ana/start
--   # approve it in the browser (or the console) — the heartbeat finishes it.
--
-- It shares state with app.syn (same declared memory), survives restarts, and
-- the operator console (synsema run console.syn) talks to it over this API.
intent: "Chat + approval inbox + durable demo workflow, served"

require memory("my-synfide-app")
require serve(8080)
require stdout
require time
require llm

use "./synfide/durable.syn" as durable
use "./synfide/approvals.syn" as approvals
use "./synfide/ui.syn" as ui
use "./synfide/agent.syn" as agent

task prepare(ctx)
    give "prepared " + ctx["name"]

task approval(ctx)
    give approvals.gate("demo-" + ctx["name"], "Approve demo for " + ctx["name"] + "?")

task activate(ctx)
    give "activated " + ctx["name"]

task wf_steps()
    give [
        {"name": "prepare", "run": prepare},
        {"name": "approval", "run": approval},
        {"name": "activate", "run": activate}
    ]

task heartbeat()
    let woken be durable.tick([{"prefix": "demo-", "steps": wf_steps()}])
    when length(woken) > 0
        log "heartbeat woke: " + json_encode(woken)

cron_every(15, heartbeat)

-- ---------- the chat is an AGENT with tools ----------
-- Ask it things like:  "onboard ana"  ·  "how is ana's onboarding going?"
-- The risky tool does NOT act directly: it starts a durable workflow that PARKS
-- in your approval inbox (/inbox/ui). You approve; the heartbeat finishes it.
-- Every dispatch — executed, rejected, failed — lands in the journal.

task tool_start_onboarding(name)
    require memory("my-synfide-app")
    require time
    let r be durable.run("demo-" + name, wf_steps(), {"name": name})
    when r["status"] == "waiting"
        give "workflow demo-" + name + " started — WAITING for human approval in the inbox (/inbox/ui). It will finish by itself once approved."
    give "workflow demo-" + name + ": " + r["status"]

task tool_check_onboarding(name)
    require memory("my-synfide-app")
    let s be durable.status_of("demo-" + name)
    give "demo-" + name + " → next step: " + text(s["next"]) + ". " + text(s["display"])

let TOOLS be {
    "start_onboarding": tool_start_onboarding,
    "check_onboarding": tool_check_onboarding
}
let CATALOG be [
    {"name": "start_onboarding", "describe": "Start an onboarding workflow for a person. It REQUIRES human approval: it parks in the approval inbox and completes only after a human approves.", "params": ["name"]},
    {"name": "check_onboarding", "describe": "Check how a person's onboarding workflow is going (next step and progress).", "params": ["name"]}
]

task chat_agent(message, history)
    give agent.respond(message, TOOLS, CATALOG, history, 4)

serve on 8080
    route "GET /"
        give html(ui.home_page())

    route "GET /chat"
        give html(ui.chat_page())

    route "GET /chat/send"
        give ui.chat_send_with(query.message, chat_agent)

    route "GET /inbox"
        give approvals.pending()

    route "GET /inbox/ui"
        give html(ui.inbox_page())

    route "GET /inbox/ui/decide"
        give ui.resolve(query.id, query.approved, query.who)

    route "POST /inbox/:id"
        let b be json of request
        when b == nothing
            give fail("body must be JSON: {\"approved\": true|false, \"who\": \"name\"}")
        let d be approvals.resolve(params.id, b["approved"], b["who"])
        when d == nothing
            give not_found("no such approval: " + params.id)
        log "decision on " + params.id + " by " + text(b["who"])
        give d

    route "POST /demo/:name/start"
        log "demo run: " + params.name
        give durable.run("demo-" + params.name, wf_steps(), {"name": params.name})

    route "GET /demo/:name"
        give durable.status_of("demo-" + params.name)
