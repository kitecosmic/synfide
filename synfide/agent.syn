-- Synfide · agent — the safe tool-calling loop, packaged. This is what turns the
-- chat from "talks" into "does": the model may PROPOSE a tool; your allow-list
-- decides if it exists; `call_tool` runs it under least-privilege (only the
-- capabilities the tool declared); the journal records every dispatch — executed,
-- rejected or failed; and the loop is bounded by max_steps. A prompt injection
-- can invent tool names all day: nothing outside the allow-list ever runs.
--
-- Tools that need a HUMAN don't block: they start a durable workflow whose gate
-- parks in the approval inbox — the agent answers "waiting for approval" and the
-- heartbeat finishes the job once a human decides. That is the whole point of
-- the framework in one loop.
--
-- The ENTRY declares the capabilities (llm under serve, memory, time, plus
-- whatever the tools themselves declare). This module declares nothing.

use "./journal.syn" as journal
use "./docs.syn" as docs
use "./store.syn" as store
use "./patches.syn" as patches
use "./durable.syn" as durable
use "./approvals.syn" as approvals

-- respond(question, tools, catalog, context, max_steps) → the agent's final text.
--   tools    — the allow-list: {"name": task}
--   catalog  — what the model sees: [{"name", "describe", "params": [...]}]
--   context  — text carried between steps (chat history goes here)
export task respond(question, tools, catalog, context, max_steps)
    let ctx be text(context)
    let step_n be 0
    while step_n < max_steps
        set step_n to step_n + 1
        let step be llm_step(question, catalog, ctx)
        when step["kind"] == "final"
            give step["text"]
        otherwise when contains(tools, step["name"])
            try
                let r be journal.dispatch(tools, step["name"], step["args"], "chat-agent")
                set ctx to ctx + " [" + step["name"] + " => " + text(r) + "]"
            recover err
                set ctx to ctx + " [" + step["name"] + " => ERROR: " + err + "]"
        otherwise
            journal.record("chat-agent", "tool-rejected", text(step["name"]))
            set ctx to ctx + " [" + text(step["name"]) + " => ERROR: tool not allowed]"
    -- Out of steps: force a final answer with what was gathered (empty catalog
    -- = the model cannot ask for more tools).
    let last be llm_step(question, [], ctx)
    give last["text"]

-- ---------- the operator baseline ----------
--
-- Every Synfide OPERATOR agent must be able to learn the language it patches
-- itself in. These tools are the in-app twin of the docs MCP / skill that
-- coding agents use outside the process: same source of truth
-- (docs.synsema.com), spoken over plain HTTP by synfide/docs.syn. They are
-- FRAMEWORK-owned so new docs surface ships with releases instead of rotting
-- in the user's entry (the old scaffold wired three of docs.syn's five
-- exports and nothing would ever have updated it). Domain tools stay in the
-- user's entry; the baseline is merged underneath by operator() — on a name
-- collision the USER's tool wins, so the baseline can never mask domain code.

task tool_synsema_docs(query)
    require net("docs.synsema.com")
    give docs.search(query)

task tool_synsema_page(slug)
    require net("docs.synsema.com")
    give docs.get_page(slug)

task tool_synsema_example(id)
    require net("docs.synsema.com")
    give docs.get_example(id)

task tool_synsema_run(code)
    require net("docs.synsema.com")
    give docs.sandbox_run(code)

task tool_synsema_verify(code)
    require net("docs.synsema.com")
    give docs.sandbox_test(code)

task base_tools()
    give {
        "synsema_docs": tool_synsema_docs,
        "synsema_page": tool_synsema_page,
        "synsema_example": tool_synsema_example,
        "synsema_run": tool_synsema_run,
        "synsema_verify": tool_synsema_verify
    }

export task base_catalog()
    give [
        {"name": "synsema_docs", "describe": "Search the OFFICIAL Synsema language docs by keyword. Use this BEFORE writing or explaining any .syn code — you do not know Synsema from training; these docs are the truth. Returns matching pages as slug/title/description.", "params": ["query"]},
        {"name": "synsema_page", "describe": "Fetch one Synsema doc page as Markdown by slug (slugs come from synsema_docs).", "params": ["slug"]},
        {"name": "synsema_example", "describe": "Fetch one official runnable Synsema example by id (ids appear in doc pages and search results).", "params": ["id"]},
        {"name": "synsema_run", "describe": "Run a Synsema snippet in the official sandbox and get its output. Use it to explore behavior while drafting code.", "params": ["code"]},
        {"name": "synsema_verify", "describe": "Run a Synsema snippet's test blocks in the official sandbox and get pass/fail. ALWAYS verify .syn code here before presenting or proposing it.", "params": ["code"]}
    ]

export task base_instructions()
    give "You are an AUTONOMOUS operator, not a consultant: when the human asks for something buildable, BUILD IT in this same turn — decide, use your tools as many times as it takes, and report what you DID, never a plan you are about to start. Do not ask permission to begin (the system's approval gates are the permission), do not end with a question you could answer by calling a tool, and NEVER close with 'shall I continue with X?' — if X is the obvious next step, you either already did it this turn or you end with 'next: X' as a statement, not a question (the human interrupts if they disagree). Never paste project code into the chat as the deliverable. Tool calls happen ONLY through the tool mechanism — text that imitates one (like '[tool => ...]') does NOTHING and must never appear in a reply: if you mean to call a tool, call it. When the human's answer is ambiguous ('yes, go on' to an either/or question), pick the better option yourself, say which in one line, and proceed — never re-ask. Keep reports SHORT: what landed, where to see it, what is next — no headed essays, no restating what the human just read. If the task is bigger than one turn allows, ship the most valuable slice NOW and end with one line saying exactly what landed and what you will do next — the human's next message (even just 'go on') resumes precisely there; never restart from zero. App logic is written in Synsema (.syn); HTML/CSS/JS only for the browser side. For anything involving Synsema code you do NOT know the language from training: search synsema_docs, read synsema_page (and synsema_example), and verify snippets with synsema_verify before shipping them."

-- The extra paragraph operator() appends ONLY when the entry wired a
-- propose_patch tool — instructions must never mention tools that don't
-- exist (the model would call them into the void).
task patch_instructions()
    give "You change this app's REAL files with propose_patch (create or edit), one file per patch, code verified with synsema_verify FIRST. Each patch is audited automatically and then waits for the human in their Approvals inbox — once approved it applies to disk BY ITSELF (no further action from you or them). So never say 'I can't create files' and never ask 'do you want me to patch it?' — patch it. Use list_patches to see what was approved, applied or rejected instead of asking the human what happened."

-- ---------- the patch flow (propose → audit → human gate → auto-apply) ----------
--
-- The framework owns the FLOW; the entry owns the POWER. patch_flow() runs
-- the whole safe chain for one change: propose (records intent, touches no
-- file), audit by the adversarial LLM auditor (rejected → the patch dies
-- here, the agent gets the reasons), then a durable workflow parks at the
-- human gate in the approvals inbox — the SAME inbox as actions, diff
-- included. The entry's heartbeat ticks the "patch-" prefix with
-- patch_steps(), so approval auto-applies with the entry's ambient file
-- scope. The entry decides that scope (e.g. `require file("./site/*")`) —
-- deny-by-default stays with the user, and patches.syn refuses synfide/
-- no matter what.

task patch_gate_step(ctx)
    let g be patches.gate(ctx["id"])
    when contains(g, "synfide")
        -- still pending. Inside an autopilot window the gate self-approves
        -- (recorded as decided_by "autopilot…", journaled) — protected
        -- approvals make resolve() raise and we stay parked, so a coded
        -- gate can never be autopiloted.
        let ap be approvals.autopilot()
        when ap != nothing
            try
                approvals.resolve("patch-" + ctx["id"], true, "autopilot (window by " + text(ap["who"]) + ")")
                journal.record("autopilot", "patch-auto-approved", text(ctx["id"]))
                give patches.gate(ctx["id"])
            recover err
                give g
    give g

task patch_apply_step(ctx)
    let r be patches.apply(ctx["id"])
    give "applied: " + text(r["path"])

export task patch_steps()
    give [
        {"name": "gate", "run": patch_gate_step},
        {"name": "apply", "run": patch_apply_step}
    ]

export task patch_flow(path, old, new, why, guidelines = "")
    -- models say "" where the contract says nothing: an empty `old` IS a create
    let o be old
    when o == ""
        set o to nothing
    -- a CREATE against an existing file dies at apply time ("never
    -- overwrites") — catch it at PROPOSE time with a usable answer instead
    -- (the real case: an agent double-proposing the same new page)
    when o == nothing
        let exists be false
        try
            set exists to file_exists(path)
        recover err
            set exists to false
        when exists
            give "REFUSED: " + text(path) + " already EXISTS — a create patch never overwrites. Read it (read_project_file) and propose an EDIT with `old` matching its current text, or pick another path."
    let id be "p" + text(store.put("synfide-patch-n", store.get("synfide-patch-n", 0) + 1))
    patches.propose(id, path, o, new, why)
    patches.audit(id, patches.llm_auditor, guidelines)
    let p be patches.get(id)
    when p["status"] != "audited-ok"
        give "patch " + id + " (" + text(p["path"]) + ") REJECTED by the auditor: " + text(p["audit_reasons"]) + " — fix the concern and propose again"
    let r be durable.run("patch-" + id, patch_steps(), {"id": id})
    let note be ""
    when ends_with(text(p["path"]), ".syn")
        set note to " NOTE: .syn code loads at boot — once applied, restart the process that runs it (restart_backend if you have it) before the new code answers."
    when r["status"] == "done"
        give "patch " + id + " (" + text(p["path"]) + ") audited-ok and APPLIED automatically (autopilot window active — the human granted standing approval)." + note
    when r["status"] == "failed"
        -- the agent must learn the REAL cause NOW, not discover a stuck
        -- patch three turns later
        give "patch " + id + " (" + text(p["path"]) + ") audited-ok but the APPLY FAILED: " + text(r["error"]) + " — the audit verdict stands; fix the cause and the patch can be re-driven (or re-propose)."
    give "patch " + id + " (" + text(p["path"]) + ") audited-ok — WAITING for the human's approval (they see it right in the chat and in Approvals); once approved it applies to disk by itself. Status: " + r["status"] + note

-- patches_summary() → one line per proposal, newest last — the agent's eyes
-- on what got approved, applied or rejected.
task patch_line(p)
    let s be text(p["id"]) + " (" + text(p["path"]) + "): " + text(p["status"]) + " — " + text(p["why"])
    when contains(p, "apply_error")
        when text(p["apply_error"]) != ""
            set s to s + " | APPLY ERROR: " + text(p["apply_error"])
    give s

export task patches_summary()
    let ps be patches.proposals()
    when length(ps) == 0
        give "no patches proposed yet"
    give join(apply(ps, (p) => patch_line(p)), "\n")

-- arg_num(v, fallback = 0) → a NUMBER from whatever the model sent as a
-- tool argument: numbers pass, numeric text parses, "" / nothing / garbage
-- give the fallback. Models SEND TEXT where the contract says number — a
-- raw `v > 0` on "3" raised 'Unsupported operation: text > number' and
-- blinded the agent's file reads. Every numeric tool param goes through
-- this.
export task arg_num(v, fallback = 0)
    when v == nothing
        give fallback
    try
        give floor(number(text(v)))
    recover err
        give fallback

-- operator_tools/operator_catalog(domain) → baseline merged UNDER the user's
-- domain: on a name collision the domain entry wins and the baseline's twin
-- is dropped entirely (allow-list and catalog stay consistent).
export task operator_tools(domain_tools)
    let merged be {}
    let bt be base_tools()
    each k in keys(bt)
        when not contains(domain_tools, k)
            set merged[k] to bt[k]
    each k in keys(domain_tools)
        set merged[k] to domain_tools[k]
    give merged

export task operator_catalog(domain_catalog)
    let names be apply(domain_catalog, (c) => c["name"])
    let merged be domain_catalog
    each c in base_catalog()
        when not contains(names, c["name"])
            set merged to merged + [c]
    give merged

-- operator(question, domain_tools, domain_catalog, domain_instructions,
-- history, max_steps) → respond() over the user's domain PLUS the framework
-- baseline. This is what the dashboard chat should run: the entry passes only
-- its domain and the framework guarantees the floor — with no domain at all
-- ({}, [], "") it is still an agent that can learn Synsema. max_steps
-- defaults HIGH (12): an autonomous build (docs → write → verify → patch,
-- times several files) eats steps fast, and a step budget that forces the
-- agent to stop mid-build reads as laziness to the human.
export task operator(question, domain_tools, domain_catalog, domain_instructions, history, max_steps = 12)
    let tools be operator_tools(domain_tools)
    let instr be base_instructions()
    when contains(tools, "propose_patch")
        set instr to instr + "\n" + patch_instructions()
    when text(domain_instructions) != ""
        set instr to text(domain_instructions) + "\n" + instr
    give respond(question, tools, operator_catalog(domain_catalog), instr + "\n--- conversation so far ---\n" + text(history), max_steps)
