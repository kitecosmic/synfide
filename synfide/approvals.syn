-- Synfide · approvals — human-in-the-loop as DATA, not as a blocked thread.
--
-- The pattern: an agent step that needs a human does NOT stop the world. It
-- registers a pending approval and parks its workflow (durable.wait). The human
-- answers whenever they answer — through a route, a chat bot, a CLI — via
-- decide(). The next run() of the workflow finds the decision and moves on.
-- Works across restarts because everything is a record in the state DB.
--
-- The entry program declares `require memory("name")` and `require time`
-- (records carry timestamps). This module declares nothing top-level.

use "./store.syn" as store

let PREFIX be "synfide-appr:"

-- request(id, message) → the approval record (idempotent: if `id` already
-- exists, the existing record is returned untouched — safe to call on every
-- workflow re-entry).
export task request(id, message)
    let existing be store.get(PREFIX + id, nothing)
    when existing != nothing
        give existing
    give store.put(PREFIX + id, {
        "id": id,
        "message": message,
        "status": "pending",
        "requested_at": text(now())
    })

-- status(id) → the record, or nothing if it was never requested.
export task status(id)
    give store.get(PREFIX + id, nothing)

-- protect(id) → a 6-digit ONE-TIME code for this approval. Send it (or a link
-- carrying it) through YOUR channel — Telegram, WhatsApp, SMS, email: whoever
-- presents the code is authorized to decide, once. After protect(), the plain
-- resolve() refuses: only resolve_coded() with the right code works.
-- Needs `require random` in the entry (codes must be unpredictable).
export task protect(id)
    let a be store.get(PREFIX + id, nothing)
    when a == nothing
        raise("approvals: cannot protect unknown approval \"" + id + "\" — request() it first")
    let code be text(random_int(100000, 999999))
    set a["code"] to code
    store.put(PREFIX + id, a)
    give code

-- resolve_coded(id, approved, who, code) → resolves a PROTECTED approval. The
-- code is single-use: it burns on success. Wrong/missing code raises.
export task resolve_coded(id, approved, who, code)
    let a be store.get(PREFIX + id, nothing)
    when a == nothing
        give nothing
    when not contains(a, "code")
        raise("approvals: \"" + id + "\" is not protected — use resolve()")
    when a["code"] == nothing
        raise("approvals: \"" + id + "\" is not protected (its code was already used) — use resolve()")
    when a["code"] != code
        raise("approvals: wrong code for \"" + id + "\"")
    set a["code"] to nothing
    store.put(PREFIX + id, a)
    give resolve(id, approved, who)

-- resolve(id, approved, who) → the updated record, or nothing if unknown id.
-- `approved` is a bool; `who` is recorded for the audit trail. Refuses if the
-- approval was protect()ed — the code IS the authorization then.
export task resolve(id, approved, who)
    let a be store.get(PREFIX + id, nothing)
    when a == nothing
        give nothing
    when contains(a, "code")
        when a["code"] != nothing
            raise("approvals: \"" + id + "\" is protected — a one-time code is required (resolve_coded)")
    when approved
        set a["status"] to "approved"
    otherwise
        set a["status"] to "denied"
    set a["decided_by"] to who
    set a["decided_at"] to text(now())
    give store.put(PREFIX + id, a)

-- pending() → every approval still waiting for a human, oldest story intact.
export task pending()
    let all be store.list(PREFIX)
    let records be apply(all, (kv) => kv["value"])
    give where(records, (a) => a["status"] == "pending")

-- ---------- autopilot: a standing, TIME-BOXED approval ----------
--
-- "Approve every patch for the next N minutes." The human grants a window;
-- inside it the patch gate auto-resolves (decided_by records "autopilot")
-- instead of parking — a 6-file site build stops needing 6 clicks. Held to
-- strict limits ON PURPOSE: it must be granted by a signed-in human, it
-- expires by itself, it NEVER touches protected (coded) approvals, and it
-- only applies where a caller explicitly consults it (the patch gate —
-- external actions keep their human click). Everything remains journaled
-- and auditable: autopilot changes WHO clicks, never what gets recorded.

let AUTO_KEY be "synfide-autopilot"

-- autopilot_set(minutes, who) → the window record; minutes <= 0 turns it off.
export task autopilot_set(minutes, who)
    when minutes <= 0
        store.del(AUTO_KEY)
        give nothing
    give store.put(AUTO_KEY, {"until": now() + minutes * 60, "who": who})

-- autopilot() → the active window record, or nothing (expired windows are
-- cleaned as a side effect — expiry needs no cron).
export task autopilot()
    let a be store.get(AUTO_KEY, nothing)
    when a == nothing
        give nothing
    when now() > a["until"]
        store.del(AUTO_KEY)
        give nothing
    give a

-- gate(id, message) → the piece that plugs into a durable step. Requests the
-- approval (idempotently) and returns:
--   still pending → the durable wait sentinel (the workflow parks)
--   approved      → the approval record (the step can proceed)
--   denied        → raises, so the workflow records the step as failed
export task gate(id, message)
    let a be request(id, message)
    when a["status"] == "pending"
        give {"synfide": "wait", "reason": "waiting for human approval: " + id}
    when a["status"] == "denied"
        raise("approval " + id + " denied by " + text(a["decided_by"]))
    give a
