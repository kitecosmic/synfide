-- Synfide test suite. Run with FRESH state and audit dirs so tests are
-- deterministic and never touch your real audit logs:
--
--   SYNSEMA_STATE_DIR=$(mktemp -d) SYNSEMA_AUDIT_DIR=$(mktemp -d) synsema test synfide/tests.syn
--
intent: "Prove store, durable re-entry, approvals, treasury, cassettes, journal and patches"

require memory("synfide-tests")
require time
require spend("T_*")
require random
require secret
require file("./.tmp-tests/*")
require file.read("./.tmp-tests")
require file.read("./.env.example")
require file.read("./synfide/ui/static/*")

use "./store.syn" as store
use "./durable.syn" as durable
use "./approvals.syn" as approvals
use "./treasury.syn" as treasury
use "./cassettes.syn" as cassettes
use "./journal.syn" as journal
use "./ui.syn" as ui
use "./agent.syn" as agent
use "./limits.syn" as limits
use "./patches.syn" as patches

-- ---------- store ----------

test "store: put/get round-trips any JSON value and upserts"
    store.put("t1:user", {"name": "ana", "n": 3})
    assert_eq(store.get("t1:user", nothing), {"name": "ana", "n": 3})
    store.put("t1:user", {"name": "ana", "n": 4})
    assert_eq(store.get("t1:user", nothing)["n"], 4)

test "store: get falls back, del removes, list filters by prefix"
    assert_eq(store.get("t2:absent", "fallback"), "fallback")
    store.put("t2:a", 1)
    store.put("t2:b", 2)
    store.put("other:c", 3)
    assert_eq(length(store.list("t2:")), 2)
    assert_eq(store.del("t2:a"), 1)
    assert_eq(length(store.list("t2:")), 1)

-- ---------- durable ----------

task s_one(ctx)
    give 10

task s_two(ctx)
    give ctx["one"] + 5

task happy_steps()
    give [{"name": "one", "run": s_one}, {"name": "two", "run": s_two}]

test "durable: happy path completes and threads results through ctx"
    let r be durable.run("t-happy", happy_steps(), {"seed": true})
    assert_eq(r["status"], "done")
    assert_eq(r["ctx"]["one"], 10)
    assert_eq(r["ctx"]["two"], 15)

task s_parks(ctx)
    give durable.wait("external world pending")

test "durable: a waiting step parks the workflow and re-entry retries it"
    let steps be [{"name": "park", "run": s_parks}]
    let r1 be durable.run("t-park", steps, {})
    assert_eq(r1["status"], "waiting")
    assert_eq(r1["step"], "park")
    let r2 be durable.run("t-park", steps, {})
    assert_eq(r2["status"], "waiting", "still parked until the world acts")

task s_boom(ctx)
    when store.get("t-fixed", nothing) == nothing
        raise("boom")
    give "recovered"

test "durable: a failed step is retried on the next run, completed steps are not re-run"
    let steps be [{"name": "one", "run": s_one}, {"name": "boom", "run": s_boom}]
    let r1 be durable.run("t-retry", steps, {})
    assert_eq(r1["status"], "failed")
    assert_eq(r1["step"], "boom")
    store.put("t-fixed", true)
    let r2 be durable.run("t-retry", steps, {})
    assert_eq(r2["status"], "done")
    assert_eq(r2["ctx"]["one"], 10, "step one ran in run 1 and was skipped in run 2")
    assert_eq(r2["ctx"]["boom"], "recovered")

-- ---------- approvals ----------

test "approvals: request is idempotent, decide flips status, pending filters"
    let a1 be approvals.request("ap-1", "ok to ship?")
    assert_eq(a1["status"], "pending")
    let a2 be approvals.request("ap-1", "DIFFERENT message must not overwrite")
    assert_eq(a2["message"], "ok to ship?")
    assert_eq(length(approvals.pending()), 1)
    let d be approvals.resolve("ap-1", true, "joel")
    assert_eq(d["status"], "approved")
    assert_eq(d["decided_by"], "joel")
    assert_eq(length(approvals.pending()), 0)
    assert_eq(approvals.resolve("ap-unknown", true, "joel"), nothing)

task s_gate(ctx)
    give approvals.gate("ap-flow", "gate?")

test "approvals + durable: gate parks, approval lets it through"
    let steps be [{"name": "gate", "run": s_gate}]
    let r1 be durable.run("t-gate", steps, {})
    assert_eq(r1["status"], "waiting")
    approvals.resolve("ap-flow", true, "joel")
    let r2 be durable.run("t-gate", steps, {})
    assert_eq(r2["status"], "done")
    assert_eq(r2["ctx"]["gate"]["status"], "approved")

-- ---------- registry + tick ----------

test "registry: workflows(prefix) reports each workflow's last status"
    durable.run("reg-a", happy_steps(), {})
    let steps be [{"name": "park", "run": s_parks}]
    durable.run("reg-b", steps, {})
    let regs be durable.workflows("reg-")
    assert_eq(length(regs), 2)
    let done be where(regs, (w) => w["status"] == "done")
    let waiting be where(regs, (w) => w["status"] == "waiting")
    assert_eq(length(done), 1)
    assert_eq(done[0]["name"], "reg-a")
    assert_eq(waiting[0]["step"], "park")
    assert_eq(length(durable.workflows("otra-cosa")), 0)

task s_tick_gate(ctx)
    give approvals.gate("ap-tick", "tick gate?")

test "tick: re-runs only the waiting workflows of the matching prefix"
    let steps be [{"name": "gate", "run": s_tick_gate}]
    durable.run("tk-1", steps, {})
    let defs be [{"prefix": "tk-", "steps": steps}]
    -- still pending → the tick re-runs it but it parks again
    let w1 be durable.tick(defs)
    assert_eq(length(w1), 1)
    assert_eq(w1[0]["status"], "waiting")
    -- approval lands → the NEXT tick finishes it, no manual run() needed
    approvals.resolve("ap-tick", true, "joel")
    let w2 be durable.tick(defs)
    assert_eq(w2, [{"name": "tk-1", "status": "done"}])
    -- done workflows are not ticked again
    assert_eq(durable.tick(defs), [])

task s_gate_denied(ctx)
    give approvals.gate("ap-denied", "gate?")

test "approvals + durable: a denial fails the step (recorded, retryable)"
    let steps be [{"name": "gate", "run": s_gate_denied}]
    let r1 be durable.run("t-denied", steps, {})
    assert_eq(r1["status"], "waiting")
    approvals.resolve("ap-denied", false, "joel")
    let r2 be durable.run("t-denied", steps, {})
    assert_eq(r2["status"], "failed")
    assert(contains(r2["error"], "denied by joel"))

-- ---------- treasury ----------

task mock_pay(amount, unit, why)
    give "receipt-" + text(amount) + "-" + unit

task failing_pay(amount, unit, why)
    raise("PSP timeout")

test "treasury: pay checks the scope budget, declares the spend, and records"
    treasury.set_budget("mkt", "T_USD", 100)
    let r be treasury.pay("mkt", 60, "T_USD", "campaign", mock_pay)
    assert_eq(r["ok"], true)
    assert_eq(r["receipt"], "receipt-60-T_USD")
    assert_eq(r["scope_spent"], 60)
    assert_eq(treasury.budget_left("mkt", "T_USD"), 40)
    assert_eq(spend_total("T_USD"), 60, "el ledger del runtime tambien lo vio")

test "treasury: the policy cut happens BEFORE anything is declared or moved"
    let before be spend_total("T_USD")
    let msg be ""
    try
        treasury.pay("mkt", 50, "T_USD", "over budget", mock_pay)
    recover err
        set msg to err
    assert(contains(msg, "budget exceeded"))
    assert_eq(spend_total("T_USD"), before, "nada llego al ledger del runtime")
    assert_eq(treasury.spent("mkt", "T_USD"), 60, "el scope no crecio")

test "treasury: a payment that fails AFTER the spend is a recorded discrepancy"
    let before be spend_total("T_USD")
    let msg be ""
    try
        treasury.pay("ops", 25, "T_USD", "flaky psp", failing_pay)
    recover err
        set msg to err
    assert(contains(msg, "AFTER the spend was declared"))
    assert_eq(spend_total("T_USD"), before + 25, "el ledger declara ANTES: sobre-cuenta honesta")
    assert_eq(treasury.spent("ops", "T_USD"), 0, "el scope NO registra un pago que no ocurrio")
    assert_eq(length(treasury.discrepancies()), 1)
    assert(contains(treasury.discrepancies()[0]["error"], "PSP timeout"))

test "treasury: a scope without budget only rides the runtime ledger"
    let r be treasury.pay("free", 5, "T_USD", "no policy", mock_pay)
    assert_eq(r["ok"], true)
    assert_eq(treasury.budget_left("free", "T_USD"), nothing)

-- ---------- cassettes ----------

test "cassettes: record then replay — the replay needs no provider at all"
    let a1 be cassettes.ask("record", "what is the capital of france")
    let a2 be cassettes.ask("replay", "what is the capital of france")
    assert_eq(a1, a2)
    assert_eq(length(cassettes.recorded()), 1)

test "cassettes: replay without a recording raises (never silently hits the network)"
    let msg be ""
    try
        cassettes.ask("replay", "never recorded prompt")
    recover err
        set msg to err
    assert(contains(msg, "no recording"))
    assert_eq(cassettes.forget("what is the capital of france"), 1)
    assert_eq(length(cassettes.recorded()), 0)

-- ---------- journal ----------

task tool_hello(name)
    give "hello " + name

task tool_boom()
    raise("tool exploded")

test "journal: dispatch journals ok, rejected and error — in order, nothing swallowed"
    let tools be {"hello": tool_hello, "boom": tool_boom}
    assert_eq(journal.dispatch(tools, "hello", {"name": "ana"}, "agent-1"), "hello ana")
    let m1 be ""
    try
        journal.dispatch(tools, "hacked_tool", {}, "agent-1")
    recover err
        set m1 to err
    assert(contains(m1, "not in allow-list"))
    let m2 be ""
    try
        journal.dispatch(tools, "boom", {}, "agent-1")
    recover err
        set m2 to err
    assert(contains(m2, "tool exploded"))
    let es be journal.entries()
    assert_eq(length(es), 3)
    assert_eq(apply(es, (e) => e["action"]), ["tool-ok", "tool-rejected", "tool-error"])
    assert_eq(es[0]["n"], 1)
    assert_eq(es[2]["actor"], "agent-1")

-- ---------- ui ----------

test "ui: the inbox page escapes user text — injected markup lands as text"
    approvals.request("xss-probe", "<script>alert(1)</script> & \"quotes\"")
    let page be ui.inbox_page()
    assert(contains(page, "&lt;script&gt;alert(1)&lt;/script&gt;"))
    assert(not contains(page, "<script>alert(1)"))
    assert(contains(page, "&amp; &quot;quotes&quot;"))
    assert(contains(page, "xss-probe"))
    assert(contains(page, "form class=\"decide\""), "el form de decision existe (postea JSON via JS)")
    assert(contains(page, "data-id=\"xss-probe\""), "el id viaja como data-attribute")

test "ui: decide resolves, journals, and redirects back to the inbox"
    approvals.request("ui-1", "ship the ui?")
    ui.resolve("ui-1", "yes", "")
    assert_eq(approvals.status("ui-1")["status"], "approved")
    assert_eq(approvals.status("ui-1")["decided_by"], "web", "quien vacio cae a \"web\"")
    let acts be apply(journal.entries(), (e) => e["action"])
    assert(contains(acts, "ui-decision"))

test "ui admin: workflows, journal y patches renderizan sus colecciones escapadas"
    let wp be ui.workflows_page()
    assert(contains(wp, "t-happy"), "el registro de workflows aparece")
    let jp be ui.journal_page()
    assert(contains(jp, "ui-decision"), "el journal lista acciones")
    patches.propose("ui-pt", "./.tmp-tests/x.md", "<script>alert(2)</script>", "safe", "ui probe <b>bold</b>")
    let pp be ui.patches_page()
    assert(contains(pp, "ui-pt"))
    assert(contains(pp, "ui probe &lt;b&gt;bold&lt;/b&gt;"), "el why del patch, escapado")
    let dp be ui.patch_page("ui-pt")
    assert(contains(dp, "&lt;script&gt;alert(2)&lt;/script&gt;"), "el diff, escapado")
    assert(not contains(dp, "<script>alert(2)"))
    assert_eq(status of ui.patch_page("no-existe"), 404)

test "ui env: una var guardada pero no cargada se muestra 'restart', y el marcador se limpia al cargarse"
    -- guardada en .env pero el proceso no la tiene -> tercer estado + banner
    store.put("synfide-env-saved:VAR_GUARDADA_PERO_NO_CARGADA", {"at": now()})
    let page be ui.env_page(["VAR_GUARDADA_PERO_NO_CARGADA"], false)
    assert(contains(page, "restart the server to load it"), "tercer estado, no un 'not set' enganoso")
    assert(contains(page, "not loaded yet"), "banner de reinicio pendiente")
    -- una var que SI esta en el entorno del proceso limpia su marcador
    store.put("synfide-env-saved:SYNSEMA_STATE_DIR", {"at": now()})
    let page2 be ui.env_page(["SYNSEMA_STATE_DIR"], false)
    assert(contains(page2, "st-done"), "cargada -> set")
    assert_eq(store.get("synfide-env-saved:SYNSEMA_STATE_DIR", nothing), nothing, "marcador limpiado")
    store.del("synfide-env-saved:VAR_GUARDADA_PERO_NO_CARGADA")

test "ui env: presencia sin valores — una var ausente es not set, nada se muestra"
    let page be ui.env_page(["SYNFIDE_TEST_VAR_QUE_NO_EXISTE"], false)
    assert(contains(page, "SYNFIDE_TEST_VAR_QUE_NO_EXISTE"))
    assert(contains(page, "st-failed"), "ausente -> not set")
    assert(not contains(page, "envset"), "sin editable no hay formulario")
    let page2 be ui.env_page(["SYNFIDE_TEST_VAR_QUE_NO_EXISTE"], true)
    assert(contains(page2, "type=\"password\""), "el valor se tipea como password")
    assert(contains(page2, "one-time code") or contains(page2, "One-time code"), "cada guardado exige el codigo de consola")

test "ui env: env_set exige codigo de consola valido, de un solo uso, y escribe .env"
    -- sin codigo pedido -> 403
    let r1 be ui.env_set({"name": "SYNFIDE_TEST_VAR_QUE_NO_EXISTE", "value": "v1", "code": "000000"}, ["SYNFIDE_TEST_VAR_QUE_NO_EXISTE"])
    assert_eq(status of r1, 403)
    -- variable fuera de la lista -> 400
    let r2 be ui.env_set({"name": "OTRA_VAR", "value": "v", "code": "1"}, ["SYNFIDE_TEST_VAR_QUE_NO_EXISTE"])
    assert_eq(status of r2, 400)
    -- valor multilinea (inyectaria variables extra) -> 400
    let r3 be ui.env_set({"name": "SYNFIDE_TEST_VAR_QUE_NO_EXISTE", "value": "a\nB=x", "code": "1"}, ["SYNFIDE_TEST_VAR_QUE_NO_EXISTE"])
    assert_eq(status of r3, 400)

test "ui env: allow_new acepta nombres UPPER_SNAKE nuevos y rechaza los malformados"
    -- sin allow_new (default), un nombre fuera de la lista sigue siendo desconocido -> 400
    let r1 be ui.env_set({"name": "SUPABASE_URL", "value": "v", "code": "1"}, ["OTRA_VAR"])
    assert_eq(status of r1, 400)
    -- con allow_new, un nombre malformado nunca llega a .env -> 400
    let r2 be ui.env_set({"name": "minusculas", "value": "v", "code": "1"}, ["OTRA_VAR"], true)
    assert_eq(status of r2, 400)
    let r3 be ui.env_set({"name": "CON ESPACIO", "value": "v", "code": "1"}, ["OTRA_VAR"], true)
    assert_eq(status of r3, 400)
    let r4 be ui.env_set({"name": "INYECTA=X", "value": "v", "code": "1"}, ["OTRA_VAR"], true)
    assert_eq(status of r4, 400)
    let r5 be ui.env_set({"name": "1EMPIEZA_CON_DIGITO", "value": "v", "code": "1"}, ["OTRA_VAR"], true)
    assert_eq(status of r5, 400)
    -- un nombre nuevo BIEN formado pasa la validacion de nombre: cae recien en
    -- el codigo de consola (403, no 400) — el .env real jamas se toca aqui
    let r6 be ui.env_set({"name": "SUPABASE_URL", "value": "v", "code": "000000"}, ["OTRA_VAR"], true)
    assert_eq(status of r6, 403)

test "ui env: env_vars_all une example, KNOWN_VARS y extras (y sin cap de .env degrada sin error)"
    let names be ui.env_vars_all(["MI_EXTRA_VAR"])
    assert(contains(names, "SYNSEMA_LLM_PROVIDER"), "KNOWN_VARS presentes")
    assert(contains(names, "MI_EXTRA_VAR"), "extras del CONFIG presentes")

test "ui upgrade: upgrade_leftovers lista solo *.new y degrada a [] sin capability"
    write_file("./.tmp-tests/probe.syn.new", "release copy")
    write_file("./.tmp-tests/normal.txt", "x")
    let found be ui.upgrade_leftovers("./.tmp-tests")
    assert(contains(found, "probe.syn.new"), "el .new aparece")
    assert(not contains(found, "normal.txt"), "los demas archivos no")
    -- un dir fuera de las capabilities no rompe la pagina: degrada a vacio
    assert_eq(ui.upgrade_leftovers("./directorio-sin-cap"), [])

test "ui endpoints: la lista curada renderiza dentro del shell"
    let page be ui.endpoints_page(["GET /x — does x.\n  curl localhost:8080/x"])
    assert(contains(page, "curl localhost:8080/x"))
    assert(contains(page, "/llms.txt"), "linkea la version para agentes")

-- ---------- chat ----------

test "chat: send records both sides and the page renders them escaped"
    ui.chat_send("hola <b>mundo</b>")
    let page be ui.chat_page()
    assert(contains(page, "hola &lt;b&gt;mundo&lt;/b&gt;"), "el mensaje del usuario, escapado")
    assert(not contains(page, "<b>mundo</b>"))
    assert(contains(page, "assistant"), "hay respuesta del asistente (offline = placeholder)")
    assert(contains(page, "/chat/send"), "el form apunta a la ruta de envio")
    assert(contains(page, "<textarea"), "el composer es multilinea")

test "chat: los saltos de linea del mensaje sobreviven y se renderizan"
    ui.chat_send("linea uno\nlinea dos")
    let page be ui.chat_page()
    assert(contains(page, "linea uno\nlinea dos"), "el \\n persiste en la historia y el bubble (pre-wrap lo muestra)")

test "chat: an empty message is a no-op redirect, history intact"
    ui.chat_send("")
    ui.chat_send(nothing)
    let page be ui.chat_page()
    assert(contains(page, "hola &lt;b&gt;mundo&lt;/b&gt;"), "la historia sigue")

-- ---------- agent ----------

task fake_responder(message, history)
    give "eco: " + message + " (con " + text(length(history)) + " chars de historia)"

test "agent: offline the loop degrades to the runtime placeholder, never crashes"
    let tools be {}
    let out be agent.respond("do something", tools, [], "", 3)
    assert(contains(out, "no llm provider"), "offline → placeholder del runtime: " + out)

test "chat_send_with: the answer comes from YOUR responder"
    ui.chat_send_with("probando al agente", fake_responder)
    let page be ui.chat_page()
    assert(contains(page, "eco: probando al agente"))

task domain_tool_x()
    give "x"

test "operator: el baseline de Synsema se une DEBAJO del dominio y el dominio gana en colision"
    -- sin dominio: el piso completo esta
    let t0 be agent.operator_tools({})
    assert(contains(t0, "synsema_docs") and contains(t0, "synsema_verify"), "docs y verify en el piso")
    assert_eq(length(keys(t0)), length(agent.base_catalog()), "allow-list y catalogo del piso coinciden")
    -- con dominio: se suma sin pisar nada
    let t1 be agent.operator_tools({"mi_tool": domain_tool_x})
    assert(contains(t1, "mi_tool") and contains(t1, "synsema_docs"))
    -- colision de nombre: la tool del USUARIO gana (jamas la enmascara el
    -- piso) — se prueba EJECUTANDO la ganadora: la del dominio es pura y
    -- responde "x"; la del piso necesitaria net(docs.synsema.com)
    let t2 be agent.operator_tools({"synsema_docs": domain_tool_x})
    assert_eq(call_tool(t2["synsema_docs"], nothing), "x")
    let c2 be agent.operator_catalog([{"name": "synsema_docs", "describe": "la mia", "params": []}])
    let mine be where(c2, (c) => c["name"] == "synsema_docs")
    assert_eq(length(mine), 1, "una sola entrada por nombre en el catalogo")
    assert_eq(mine[0]["describe"], "la mia")

test "operator: offline degrada al placeholder igual que respond, con dominio vacio"
    let out be agent.operator("hola", {}, [], "", "", 2)
    assert(contains(out, "no llm provider"), "offline → placeholder del runtime: " + out)

-- ---------- patch flow (las manos del agente) ----------

test "patch_flow: offline el auditor LLM no aprueba — el patch muere ANTES de cualquier workflow"
    let out be agent.patch_flow("./.tmp-tests/never.html", nothing, "<h1>x</h1>", "probe")
    assert(contains(out, "REJECTED"), "sin auditor real no se avanza: " + out)
    assert_eq(length(durable.workflows("patch-p")), 0, "ningun workflow de patch arranco")

task approving_auditor(patch, guidelines)
    give {"approved": true, "reasons": "test: cambio chico y seguro"}

test "patch loop completo: propose -> audit ok -> gate en el inbox -> aprobar -> apply escribe el archivo"
    -- nombre unico por corrida: .tmp-tests persiste entre runs y un CREATE
    -- jamas pisa un archivo existente (esa negativa tiene su propio test)
    let eid be "e2e-" + text(now())
    let epath be "./.tmp-tests/site-" + eid + ".html"
    patches.propose(eid, epath, nothing, "<h1>hola sitio</h1>", "create the page")
    patches.audit(eid, approving_auditor, "")
    assert_eq(patches.get(eid)["status"], "audited-ok")
    -- el workflow parquea en el gate humano
    let r1 be durable.run("patch-" + eid, agent.patch_steps(), {"id": eid})
    assert_eq(r1["status"], "waiting")
    let pend be apply(approvals.pending(), (a) => a["id"])
    assert(contains(pend, "patch-" + eid), "el gate esta en el inbox de aprobaciones")
    -- el humano aprueba -> el (heartbeat) re-run aplica DE VERDAD
    approvals.resolve("patch-" + eid, true, "tester")
    let r2 be durable.run("patch-" + eid, agent.patch_steps(), {"id": eid})
    assert_eq(r2["status"], "done")
    assert_eq(patches.get(eid)["status"], "applied")
    assert(contains(read_file(epath), "hola sitio"), "el archivo REAL existe con el contenido")

test "patch loop: un gate DENEGADO nunca llega al filesystem"
    patches.propose("e2e-no", "./.tmp-tests/site-denied.html", nothing, "<h1>no</h1>", "create denied page")
    patches.audit("e2e-no", approving_auditor, "")
    durable.run("patch-e2e-no", agent.patch_steps(), {"id": "e2e-no"})
    approvals.resolve("patch-e2e-no", false, "tester")
    let r be durable.run("patch-e2e-no", agent.patch_steps(), {"id": "e2e-no"})
    assert_eq(r["status"], "failed", "gate denegado -> el step falla, no aplica")
    assert(not file_exists("./.tmp-tests/site-denied.html"), "el filesystem quedo intacto")

-- ---------- static_file (el sitio del agente, servido en vivo) ----------

test "static_file: sirve html/css con su content-type, index por default, y 404 en lo ausente"
    write_file("./.tmp-tests/index.html", "<h1>portada</h1>")
    write_file("./.tmp-tests/style.css", "body { color: blue }")
    let home be ui.static_file("./.tmp-tests", "")
    assert(contains(body of home, "portada"), "'' resuelve a index.html")
    let css be ui.static_file("./.tmp-tests", "style.css")
    assert(contains(body of css, "color: blue"))
    let missing be ui.static_file("./.tmp-tests", "nope.html")
    assert_eq(status of missing, 404)

test "static_file: el traversal se rechaza, tambien con backslashes"
    let a be ui.static_file("./.tmp-tests", "../serve.syn")
    assert_eq(status of a, 404)
    let b be ui.static_file("./.tmp-tests", "..\\..\\.env")
    assert_eq(status of b, 404)

test "preview_file: muestra lo servido, trunca lo largo y el 404 es texto (no error)"
    write_file("./.tmp-tests/prev.html", "<h1>vista previa</h1>")
    assert(contains(ui.preview_file("./.tmp-tests", "prev.html"), "vista previa"))
    let long be ui.preview_file("./.tmp-tests", "prev.html", 5)
    assert(contains(long, "truncated"), "se trunca con nota: " + long)
    assert(contains(ui.preview_file("./.tmp-tests", "no-existe.html"), "404"), "el 404 llega como texto al agente")

test "journal.tail: las ultimas k entradas, compactas, una por linea"
    journal.record("tester", "probe-a", "primera")
    journal.record("tester", "probe-b", "segunda")
    let t be journal.tail(2)
    assert(contains(t, "probe-b"), "la mas nueva esta")
    assert(not contains(t, "patch-apply") or length(split(t, "\n")) == 2, "solo k lineas")
    assert_eq(length(split(t, "\n")), 2)

test "resolve_all: aprueba todo lo plano de una vez y SALTEA lo protegido por codigo"
    approvals.request("bulk-1", "primera accion")
    approvals.request("bulk-2", "segunda accion")
    approvals.request("bulk-3", "accion sensible")
    approvals.protect("bulk-3")
    let r be ui.resolve_all_json({"who": "tester"})
    -- >= y no ==: otros tests dejan pendientes propios en el store compartido
    assert(r["approved"] >= 2, "al menos las dos planas aprobadas: " + text(r["approved"]))
    assert(r["skipped_protected"] >= 1, "la protegida NO se aprueba en lote")
    assert_eq(approvals.status("bulk-1")["status"], "approved")
    assert_eq(approvals.status("bulk-2")["status"], "approved")
    assert_eq(approvals.status("bulk-3")["status"], "pending", "la protegida sigue esperando su codigo")

-- ---------- limits ----------

test "limits: charge accumulates, within cuts, reset forgets"
    assert_eq(limits.spent("u:1"), 0)
    limits.charge("u:1", 12000)
    assert_eq(limits.charge("u:1", 12000), 24000)
    assert(limits.within("u:1", 30000))
    limits.charge("u:1", 12000)
    assert(not limits.within("u:1", 30000), "36000 >= 30000: corta")
    assert_eq(limits.spent("u:2"), 0, "las claves no se mezclan")
    limits.reset("u:1")
    assert_eq(limits.spent("u:1"), 0)

-- ---------- patches (auto-modificacion con auditor) ----------

task yes_auditor(patch, guidelines)
    give {"approved": true, "reasons": "looks safe: " + text(guidelines)}

task no_auditor(patch, guidelines)
    give {"approved": false, "reasons": "too risky"}

test "patches: propose is idempotent and NEVER accepts synfide/ paths"
    let p1 be patches.propose("pt-1", "./.tmp-tests/brain.md", "be brief", "be brief and kind", "user feedback")
    assert_eq(p1["status"], "proposed")
    let p2 be patches.propose("pt-1", "./other.md", "x", "y", "must not overwrite")
    assert_eq(p2["path"], ".tmp-tests/brain.md", "el registro original queda intacto")
    let m1 be ""
    try
        patches.propose("pt-bad", "synfide/ui.syn", "a", "b", "nope")
    recover err
        set m1 to err
    assert(contains(m1, "framework files"))
    let m2 be ""
    try
        patches.propose("pt-bad2", ".\\synfide\\ui.syn", "a", "b", "ni con backslashes")
    recover err
        set m2 to err
    assert(contains(m2, "framework files"))
    let m3 be ""
    try
        patches.propose("pt-bad3", "./app/synfide/ui.syn", "a", "b", "ni anidado")
    recover err
        set m3 to err
    assert(contains(m3, "framework files"))

test "patches: apply refuses without an audited-ok verdict"
    let m be ""
    try
        patches.apply("pt-1")
    recover err
        set m to err
    assert(contains(m, "not audited-ok"))

test "patches: audited-ok -> apply edits the real file, journaled"
    write_file("./.tmp-tests/brain.md", "INSTRUCTIONS\nbe brief\n")
    let a be patches.audit("pt-1", yes_auditor, "keep it small")
    assert_eq(a["status"], "audited-ok")
    assert(contains(a["audit_reasons"], "keep it small"), "el auditor recibe las guidelines")
    let r be patches.apply("pt-1")
    assert_eq(r["status"], "applied")
    assert(contains(read_file("./.tmp-tests/brain.md"), "be brief and kind"))
    let r2 be patches.apply("pt-1")
    assert_eq(r2["status"], "applied", "re-apply es no-op idempotente")
    let acts be apply(journal.entries(), (e) => e["action"])
    assert(contains(acts, "patch-proposed"))
    assert(contains(acts, "patch-audit"))
    assert(contains(acts, "patch-applied"))

test "patches: a rejecting auditor blocks apply"
    patches.propose("pt-2", "./.tmp-tests/brain.md", "INSTRUCTIONS", "HACKED", "malicious-looking")
    let a be patches.audit("pt-2", no_auditor, "")
    assert_eq(a["status"], "audited-no")
    let m be ""
    try
        patches.apply("pt-2")
    recover err
        set m to err
    assert(contains(m, "not audited-ok"))

test "patches: a human gate parks a durable step and interlocks apply"
    patches.propose("pt-3", "./.tmp-tests/brain.md", "be brief and kind", "be verbose", "debatable change")
    patches.audit("pt-3", yes_auditor, "")
    let g1 be patches.gate("pt-3")
    assert_eq(g1["synfide"], "wait", "sin humano, parkea")
    -- audited-ok pero la gate existe y esta pendiente → apply se rehusa
    let m be ""
    try
        patches.apply("pt-3")
    recover err
        set m to err
    assert(contains(m, "human-gated"))
    approvals.resolve("patch-pt-3", true, "joel")
    let g2 be patches.gate("pt-3")
    assert_eq(g2["status"], "approved")
    let r be patches.apply("pt-3")
    assert_eq(r["status"], "applied")
    assert(contains(read_file("./.tmp-tests/brain.md"), "be verbose"))

test "patches: si el archivo cambio y old ya no matchea, apply-failed queda registrado"
    patches.propose("pt-4", "./.tmp-tests/brain.md", "text that is not there", "x", "stale patch")
    patches.audit("pt-4", yes_auditor, "")
    let m be ""
    try
        patches.apply("pt-4")
    recover err
        set m to err
    assert(contains(m, "apply failed"))
    assert_eq(patches.get("pt-4")["status"], "apply-failed")

test "patches: old=nothing CREA el archivo nuevo (asi crece la app del usuario)"
    -- nombre unico por corrida: el estado es fresco en cada run pero los
    -- archivos de .tmp-tests persisten, y un create jamas pisa uno existente
    let fresh be "./.tmp-tests/pages/presupuestos-" + text(now()) + ".html"
    patches.propose("pt-5", fresh, nothing, "<h1>Presupuestos</h1>", "the agent grows the app")
    let a be patches.audit("pt-5", yes_auditor, "")
    assert(contains(patches.diff_text(patches.get("pt-5")), "+++ new file"))
    let r be patches.apply("pt-5")
    assert_eq(r["status"], "applied")
    assert_eq(read_file(fresh), "<h1>Presupuestos</h1>")

test "patches: un create JAMAS pisa un archivo existente"
    patches.propose("pt-6", "./.tmp-tests/brain.md", nothing, "overwrite attempt", "must fail")
    patches.audit("pt-6", yes_auditor, "")
    let m be ""
    try
        patches.apply("pt-6")
    recover err
        set m to err
    assert(contains(m, "never overwrites"))
    assert_eq(patches.get("pt-6")["status"], "apply-failed")
    assert(contains(read_file("./.tmp-tests/brain.md"), "be verbose"), "el archivo quedo intacto")

test "patches: proposals() lista todo en orden de propuesta"
    let ps be where(patches.proposals(), (p) => starts_with(p["id"], "pt-"))
    assert_eq(length(ps), 6)
    assert_eq(ps[0]["id"], "pt-1")
    assert_eq(ps[5]["id"], "pt-6")

-- ---------- auth: superadmin de primer arranque + sesiones ----------

test "auth: el wizard exige el codigo de consola y crea el superadmin UNA vez"
    assert(not ui.users_exist())
    ui.setup_code()
    let code be store.get("synfide-setup-code", nothing)
    assert(code != nothing, "el codigo existe (solo en consola y store, jamas en HTTP)")
    -- codigo equivocado -> 403, y el intento no quema el codigo real
    assert_eq(status of ui.setup_submit({"name": "joel", "pass": "supersegura1", "pass2": "supersegura1", "code": "000000"}), 403)
    -- validaciones con codigo correcto (fallar la validacion tampoco lo quema)
    assert_eq(status of ui.setup_submit({"name": "joel", "pass": "corta", "pass2": "corta", "code": code}), 400)
    assert_eq(status of ui.setup_submit({"name": "joel", "pass": "passwordAA1", "pass2": "passwordBB1", "code": code}), 400)
    assert_eq(store.get("synfide-setup-code", nothing), code, "el codigo sobrevive a los fallos")
    -- flujo feliz: crea, firma, y QUEMA el codigo
    ui.setup_submit({"name": "joel", "pass": "supersegura1", "pass2": "supersegura1", "code": code})
    assert(ui.users_exist())
    assert_eq(store.get("synfide-setup-code", nothing), nothing, "codigo quemado tras el exito")
    -- y el setup queda cerrado para siempre
    assert_eq(status of ui.setup_submit({"name": "otro", "pass": "supersegura1", "pass2": "supersegura1", "code": "1"}), 403)
    let m3 be ""
    try
        ui.create_first_admin("otro", "supersegura1", "supersegura1")
    recover err
        set m3 to err
    assert(contains(m3, "already done"), "solo el PRIMER arranque crea cuentas")

test "auth: el hash es argon2id y jamas se guarda la password en claro"
    let raw be store.get("synfide-user:joel", nothing)
    assert(starts_with(raw["phc"], "$argon2id$"))
    assert(not contains(raw["phc"], "supersegura1"))

test "auth: login correcto abre sesion; incorrecto no; logout la cierra"
    assert_eq(ui.login_check("joel", "malamala99"), nothing)
    assert_eq(ui.login_check("nadie", "supersegura1"), nothing)
    let u be ui.login_check("joel", "supersegura1")
    assert_eq(u["name"], "joel")
    let sid be ui.session_start(u)
    assert(length(sid) >= 16, "token() de sesion largo")
    assert_eq(ui.session_user(sid)["name"], "joel")
    ui.session_end(sid)
    assert_eq(ui.session_user(sid), nothing)
    assert_eq(ui.session_user(nothing), nothing)

test "auth: guard deja pasar con sesion y redirige sin ella; guard_api da 401"
    let sin be {"cookies": {}}
    assert(ui.guard(sin) != nothing, "sin sesion -> redirect a /login")
    assert_eq(status of ui.guard_api(sin), 401)
    let u be ui.login_check("joel", "supersegura1")
    let sid be ui.session_start(u)
    let con be {"cookies": {"sid": sid}}
    assert_eq(ui.guard(con), nothing, "con sesion pasa")
    assert_eq(ui.guard_api(con), nothing)
    -- authenticate: cookie -> user; nada -> nothing
    assert_eq(ui.authenticate(nothing, con)["name"], "joel")
    assert_eq(ui.authenticate(nothing, sin), nothing)

test "auth: setup y login pages renderizan (password fields, JSON posts)"
    let lp be ui.login_page()
    assert(contains(lp, "type=\"password\""))
    assert(contains(lp, "data-mode=\"login\""))
    let r be ui.login_submit({"name": "joel", "pass": "malamala99"})
    assert_eq(status of r, 403)

-- ---------- env desde .env.example ----------

test "env: env_names_from_example lista TODAS las variables documentadas"
    write_file("./.tmp-tests/env.example", "# Synsema config\n# SYNSEMA_LLM_PROVIDER=anthropic\nANTHROPIC_API_KEY=\n#OPENAI_API_KEY=sk-...\n# not a var line\n# SYNSEMA_LLM_PROVIDER=repeat-must-dedupe\n")
    let names be ui.env_names_from_example("./.tmp-tests/env.example")
    assert_eq(names, ["SYNSEMA_LLM_PROVIDER", "ANTHROPIC_API_KEY", "OPENAI_API_KEY"])
    assert_eq(ui.env_names_from_example("./.tmp-tests/no-existe"), [])

-- ---------- decide por JSON (los botones del inbox) ----------

test "inbox: resolve_json decide, journalea y rechaza cuerpos invalidos"
    approvals.request("json-1", "ship it?")
    assert_eq(status of ui.resolve_json(nothing), 400)
    assert_eq(status of ui.resolve_json({"id": "no-existe", "approved": true, "who": "x"}), 404)
    let r be ui.resolve_json({"id": "json-1", "approved": true, "who": "joel"})
    assert_eq(r["ok"], true)
    assert_eq(approvals.status("json-1")["status"], "approved")

-- ---------- el dispatcher: la superficie completa en 3 rutas ----------

test "dispatcher: sirve todo por catch-all, guardia sin sesion, 404 en lo desconocido"
    let u be ui.login_check("joel", "supersegura1")
    let sid be ui.session_start(u)
    let req be {"cookies": {"sid": sid}, "headers": {}}
    let q be {"message": ""}
    assert(contains(body of ui.admin_get("", req, q, nothing), "Recent actions"), "home")
    assert(contains(body of ui.admin_get("admin/journal", req, q, nothing), "Journal"), "journal")
    assert(contains(body of ui.admin_get("admin/env", req, q, nothing), "SYNFIDE_ADMIN_TOKEN"), "env con union de variables")
    assert_eq(status of ui.admin_get("no-existe", req, q, nothing), 404)
    let anon be {"cookies": {}, "headers": {}}
    let r be ui.admin_get("chat", anon, q, nothing)
    assert(status of r >= 300, "sin sesion -> redirect al login")
    assert(contains(body of ui.admin_get("llms.txt", anon, q, nothing), "API"), "llms.txt es publico")
    -- los assets los sirve el dispatcher (un static mount seria sombreado por
    -- el catch-all) y son publicos: la pagina de login necesita su css
    let css be ui.admin_get("synfide-ui/synfide.css", anon, q, nothing)
    assert(contains(body of css, "--bg:"), "el css real, sin sesion")
    let js be ui.admin_get("synfide-ui/synfide.js", anon, q, nothing)
    assert(contains(body of js, "envset"), "el js real, sin sesion")
    assert_eq(status of ui.admin_get("synfide-ui/otro.txt", anon, q, nothing), 404, "whitelist estricta")
    assert_eq(status of ui.admin_get("synfide-ui/../ui.syn", anon, q, nothing), 404, "sin traversal")

test "dispatcher: modo open (demos) no exige sesion; el API respeta el guard"
    let anon be {"cookies": {}, "headers": {}}
    let q be {"message": ""}
    let cfg be {"open": true}
    assert(contains(body of ui.admin_get("admin/workflows", anon, q, cfg), "Workflows"), "open: paginas sin login")
    -- API inbox: cerrado -> 401; open -> pasa
    assert_eq(status of ui.admin_get("inbox", anon, q, nothing), 401)
    let pend be ui.admin_get("inbox", anon, q, cfg)
    assert(pend != nothing, "open: inbox JSON responde")
    -- decidir por API en open mode
    approvals.request("disp-1", "dispatch me")
    let anon_post be {"cookies": {}, "headers": {}, "json": {"approved": true, "who": "disp"}}
    let d be ui.admin_post("inbox/disp-1", anon_post, cfg)
    assert_eq(d["status"], "approved")
    assert_eq(status of ui.admin_post("inbox/no-existe", anon_post, cfg), 404)
    -- el inbox JSON JAMAS filtra el codigo de un approval protegido — el
    -- codigo viaja solo por el canal del operador
    approvals.request("disp-prot", "protected probe")
    approvals.protect("disp-prot")
    let inbox_json be json_encode(ui.admin_get("inbox", anon, q, cfg))
    assert(not contains(inbox_json, "\"code\""), "el codigo no sale por el API")
    assert(contains(inbox_json, "\"protected\": true") or contains(inbox_json, "\"protected\":true"), "pero se declara protegido")
    -- regresion: decide_all es superficie de BROWSER — no puede caer en la
    -- rama del API y leerse como el approval id "ui/decide_all"
    approvals.request("disp-2", "bulk dispatch me")
    let all be ui.admin_post("inbox/ui/decide_all", {"cookies": {}, "headers": {}, "json": {"who": "disp"}}, cfg)
    assert(contains(all, "approved"), "decide_all rutea a resolve_all_json: " + text(all))
    assert_eq(approvals.status("disp-2")["status"], "approved")

-- ---------- approvals con codigo (OTP por cualquier canal) ----------

test "approvals: protect exige el codigo correcto, una sola vez"
    approvals.request("otp-1", "pay the invoice?")
    let code be approvals.protect("otp-1")
    assert_eq(length(code), 6)
    -- el resolve plano se rehusa
    let m1 be ""
    try
        approvals.resolve("otp-1", true, "joel")
    recover err
        set m1 to err
    assert(contains(m1, "one-time code is required"))
    -- codigo equivocado se rehusa
    let m2 be ""
    try
        approvals.resolve_coded("otp-1", true, "joel", "000000")
    recover err
        set m2 to err
    assert(contains(m2, "wrong code"))
    -- codigo correcto resuelve y se QUEMA
    let d be approvals.resolve_coded("otp-1", true, "joel", code)
    assert_eq(d["status"], "approved")
    let m3 be ""
    try
        approvals.resolve_coded("otp-1", false, "otro", code)
    recover err
        set m3 to err
    assert(contains(m3, "not protected"), "el codigo ya no existe: " + m3)
