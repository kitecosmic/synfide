-- Synfide · ui — the operator surfaces, laid out like an ADMIN (think Django
-- admin): a dark branding band, a live status strip, breadcrumbs, a section
-- sidebar, and content in captioned modules. Built the Synsema way: real
-- `render()` templates (auto-escaped holes, one shared layout) + real static
-- assets. This module only builds the DATA; the markup lives in files a
-- designer can open:
--
--     synfide/ui/layouts/base.html      the admin shell: header, strip,
--                                       breadcrumbs, sidebar, { slot }
--     synfide/ui/pages/home.html        the dashboard (app index + recent actions)
--     synfide/ui/pages/inbox.html       approvals — decide with one click
--     synfide/ui/pages/workflows.html   every workflow and where it stands
--     synfide/ui/pages/patches.html     every proposed self-modification
--     synfide/ui/pages/patch.html       one patch: fields, verdicts, the diff
--     synfide/ui/pages/journal.html     the action ledger
--     synfide/ui/pages/chat.html        talk to your agent
--     synfide/ui/static/synfide.{css,js}
--
-- The ENTRY wires routes, static mount, auth and guards — scaffold/serve.syn
-- is the canonical wiring: `auth with` on ui.authenticate (bearer for
-- scripts + session cookie for humans), /setup /login /logout, and every
-- browser page behind `let g be ui.guard(request)`.
--
-- To restyle or restructure: never edit synfide/ (upgrades replace it). Copy
-- the template(s) you want to own into your folder, mount your own static
-- dir, and render your copies from your own routes — `render()` is a
-- language builtin, the framework adds nothing in between.
--
-- Security: every template hole is auto-escaped by `render()` (user text —
-- approval messages, workflow names, chat turns, patch diffs — lands as text,
-- never as markup). `{ raw ... }` is never used in these templates.

use "./store.syn" as store
use "./durable.syn" as durable
use "./approvals.syn" as approvals
use "./journal.syn" as journal
use "./patches.syn" as patches

-- HTML-escape for the few NON-template responses (plain-text errors).
task esc(v)
    let s be text(v)
    set s to replace_text(s, "&", "&amp;")
    set s to replace_text(s, "<", "&lt;")
    set s to replace_text(s, ">", "&gt;")
    set s to replace_text(s, "\"", "&quot;")
    give s

-- ---------- shared shell data ----------

-- Every page carries the admin shell's data: breadcrumb, sidebar state, and
-- the live trust strip (pending approvals · parked workflows · llm tokens —
-- the system never hides). `refresh`/`scroll` are behaviors the JS reads from
-- body data-attributes.
task shell_data(title, active, crumb, refresh, scroll)
    let wfs be durable.workflows("")
    let pending_n be length(approvals.pending())
    let leftovers be upgrade_leftovers()
    let d be {
        "title": title,
        "crumb": crumb,
        "nav_home": "",
        "nav_chat": "",
        "nav_inbox": "",
        "nav_workflows": "",
        "nav_patches": "",
        "nav_journal": "",
        "nav_env": "",
        "nav_endpoints": "",
        "pending_n": pending_n,
        "pending_badge": pending_n > 0,
        "parked_n": length(where(wfs, (w) => w["status"] == "waiting")),
        "tokens": llm_usage(),
        "refresh": refresh,
        "scroll": scroll,
        "new_files": join(leftovers, " · "),
        "has_new_files": length(leftovers) > 0
    }
    set d["nav_" + active] to "on"
    give d

task journal_tail(k)
    let es be journal.entries()
    let maxn be length(es)
    give where(es, (e) => e["n"] > maxn - k)

-- ---------- view transforms (maps ready for the templates) ----------

task appr_view(a)
    let msg be text(a["message"])
    let cls be "msg-text"
    when contains(msg, "\n")
        set cls to "msg-text mono"
    give {"id": a["id"], "message": msg, "cls": cls}

task wf_view(w)
    let step be ""
    when contains(w, "step")
        set step to " @ " + text(w["step"])
    give {"name": w["name"], "status": w["status"], "step": step, "cls": "st-" + text(w["status"])}

task patch_cls(status)
    when status == "applied"
        give "st-done"
    when status == "audited-no"
        give "st-failed"
    when status == "apply-failed"
        give "st-error"
    give "st-waiting"

task patch_view(p)
    give {"id": p["id"], "path": p["path"], "status": p["status"], "why": text(p["why"]), "cls": patch_cls(p["status"])}

-- ---------- pages ----------

-- home_page() → the dashboard (route it at GET /): the app index — each
-- collection with its counts — plus the recent actions ledger.
export task home_page()
    let wfs be durable.workflows("")
    let tail be journal_tail(8)
    let d be shell_data("Synfide", "home", "", "", "")
    set d["done_n"] to length(where(wfs, (w) => w["status"] == "done"))
    set d["patches_n"] to length(patches.proposals())
    set d["journal_n"] to length(journal.entries())
    set d["journal"] to tail
    set d["has_journal"] to length(tail) > 0
    give body of render("synfide/ui/pages/home.html", d)

-- inbox_page() → the approvals, decide with one click (auto-refreshes, but
-- never while a field has focus).
export task inbox_page()
    let pending be approvals.pending()
    let d be shell_data("Synfide — approvals", "inbox", "Approvals", "1", "")
    set d["approvals"] to apply(pending, (a) => appr_view(a))
    set d["has_pending"] to length(pending) > 0
    give body of render("synfide/ui/pages/inbox.html", d)

-- workflows_page() → every workflow the registry knows and where it stands.
export task workflows_page()
    let wfs be durable.workflows("")
    let d be shell_data("Synfide — workflows", "workflows", "Workflows", "1", "")
    set d["workflows"] to apply(wfs, (w) => wf_view(w))
    set d["has_wfs"] to length(wfs) > 0
    give body of render("synfide/ui/pages/workflows.html", d)

-- journal_page() → the action ledger, newest last (last 100).
export task journal_page()
    let es be journal.entries()
    let tail be journal_tail(100)
    let d be shell_data("Synfide — journal", "journal", "Journal", "1", "")
    set d["journal"] to tail
    set d["has_journal"] to length(tail) > 0
    set d["journal_n"] to length(es)
    set d["shown_n"] to length(tail)
    give body of render("synfide/ui/pages/journal.html", d)

-- patches_page() → every proposed self-modification and its verdict.
export task patches_page()
    let ps be patches.proposals()
    let d be shell_data("Synfide — patches", "patches", "Patches", "1", "")
    set d["patches"] to apply(ps, (p) => patch_view(p))
    set d["has_patches"] to length(ps) > 0
    give body of render("synfide/ui/pages/patches.html", d)

-- patch_page(id) → one patch in full: fields, auditor verdict, human gate,
-- and the exact before/after.
export task patch_page(id)
    let p be patches.get(id)
    when p == nothing
        give respond("unknown patch: " + esc(id), "text/plain", 404)
    let d be shell_data("Synfide — patch " + text(id), "patches", "Patches › " + text(id), "", "")
    set d["id"] to p["id"]
    set d["path"] to p["path"]
    set d["status"] to p["status"]
    set d["cls"] to patch_cls(p["status"])
    set d["why"] to text(p["why"])
    set d["has_audit"] to contains(p, "audit_reasons")
    set d["audit_reasons"] to ""
    when contains(p, "audit_reasons")
        set d["audit_reasons"] to text(p["audit_reasons"])
    let g be approvals.status("patch-" + text(id))
    set d["has_gate"] to g != nothing
    set d["gate"] to ""
    when g != nothing
        set d["gate"] to text(g["status"])
    set d["has_error"] to contains(p, "apply_error")
    set d["apply_error"] to ""
    when contains(p, "apply_error")
        set d["apply_error"] to text(p["apply_error"])
    set d["diff"] to patches.diff_text(p)
    give body of render("synfide/ui/pages/patch.html", d)

-- ---------- auth: first-run superadmin, real sessions, login ----------
-- The Django-style story, on engine v0.5.6+: the FIRST visit (no users yet)
-- redirects to /setup — choose a username and type the password twice → that
-- account is the superadmin, argon2id-hashed (password_hash, OWASP params),
-- never stored raw. After that, /login → session id from token() (needs
-- `require random`) → HttpOnly/SameSite=Lax cookie. The ENTRY wires it:
--
--     task app_auth(token, request)          -- bearer for APIs + cookie for humans
--         give ui.authenticate(token, request)
--     serve on 8080
--         auth with app_auth
--         route "GET /"  ...guard first...
--
-- and guards each browser page:  let g be ui.guard(request) / when g != nothing / give g

let SESS_TTL be 604800

export task users_exist()
    give length(store.list("synfide-user:")) > 0

-- create_first_admin(name, pass, pass2) → the superadmin — ONLY while no user
-- exists (the /setup wizard); afterwards it refuses forever.
export task create_first_admin(name, pass, pass2)
    when users_exist()
        raise("setup already done — sign in at /login")
    let n be trim(text(name))
    when n == ""
        raise("username required")
    when length(n) > 32
        raise("username too long (max 32)")
    when text(pass) != text(pass2)
        raise("passwords do not match")
    when length(text(pass)) < 8
        raise("password too short (min 8 characters)")
    store.put("synfide-user:" + n, {"name": n, "phc": password_hash(text(pass)), "role": "superadmin", "created_at": text(now())})
    journal.record(n, "auth-setup", "superadmin account created")
    give {"name": n, "role": "superadmin"}

-- login_check(name, pass) → {name, role} or nothing. Argon2id verify is
-- constant-time; a corrupt stored hash raises (never confused with "wrong
-- password") — callers decide how loudly to fail.
export task login_check(name, pass)
    let u be store.get("synfide-user:" + trim(text(name)), nothing)
    when u == nothing
        give nothing
    when password_verify(text(pass), u["phc"])
        give {"name": u["name"], "role": u["role"]}
    give nothing

export task session_start(user)
    let sid be token()
    store.put("synfide-sess:" + sid, {"name": user["name"], "role": user["role"], "at": now()})
    give sid

export task session_user(sid)
    when sid == nothing
        give nothing
    let s be store.get("synfide-sess:" + text(sid), nothing)
    when s == nothing
        give nothing
    when now() - s["at"] > SESS_TTL
        store.del("synfide-sess:" + text(sid))
        give nothing
    give {"name": s["name"], "role": s["role"]}

export task session_end(sid)
    when sid != nothing
        store.del("synfide-sess:" + text(sid))
    give nothing

-- 303 See Other — NEVER the engine's redirect() (301 Moved Permanently) for
-- anything session-dependent: browsers cache a 301 and replay it forever, so
-- one visit to a guarded page while signed out would poison that URL with a
-- permanent hop to /login. Auth-dependent redirects must be temporary.
task go(path)
    give with_header(respond("", "text/plain", 303), "Location", path)

-- Missing-key access raises in Synsema — read the session cookie defensively.
task cookie_sid(request)
    when not contains(request, "cookies")
        give nothing
    let cs be request["cookies"]
    when not contains(cs, "sid")
        give nothing
    give cs["sid"]

-- authenticate(token, request) → the ONE auth task for `auth with`: an agent
-- or script presents `Authorization: Bearer <SYNFIDE_ADMIN_TOKEN>` (sealed,
-- constant-time), a human presents the session cookie. Either becomes
-- request.user; neither → 401 on `requires auth` routes.
export task authenticate(token, request)
    when token != nothing
        when text(token) != ""
            try
                when constant_time_eq(text(token), secret("SYNFIDE_ADMIN_TOKEN"))
                    give {"id": "api-admin", "name": "api", "role": "superadmin"}
            recover err
                journal.record("auth", "auth-note", "bearer presented but SYNFIDE_ADMIN_TOKEN unset or mismatch")
    give session_user(cookie_sid(request))

-- guard(request) → for BROWSER pages: nothing when signed in; otherwise the
-- redirect to follow (/setup on first run, /login after). Wire it at the TOP
-- of every page route.
export task guard(request)
    when not users_exist()
        give go("/setup")
    when session_user(cookie_sid(request)) == nothing
        give go("/login")
    give nothing

-- guard_api(request) → same check for fetch/JSON routes: nothing, or a 401.
export task guard_api(request)
    when session_user(cookie_sid(request)) == nothing
        give respond("not signed in", "text/plain", 401)
    give nothing

-- setup_code() → the first-run gate that makes an OPEN bind safe: while no
-- account exists, a code lives in the store and is printed ONLY to the server
-- terminal — whoever completes the wizard must have console access, so a
-- stranger on the network can never win the first-run race. Idempotent; never
-- travels in HTTP; burned when setup succeeds.
export task setup_code()
    when users_exist()
        give nothing
    let c be store.get("synfide-setup-code", nothing)
    when c == nothing
        set c to text(random_int(100000, 999999))
        store.put("synfide-setup-code", c)
    log "FIRST RUN — setup code: " + c + "  (type it in the /setup wizard; only this terminal shows it)"
    give nothing

export task setup_page()
    setup_code()
    give body of render("synfide/ui/pages/setup.html", {"title": "Synfide — first run"})

export task login_page()
    give body of render("synfide/ui/pages/login.html", {"title": "Synfide — sign in"})

-- setup_submit(body) → verifies the console code, creates the superadmin and
-- signs them in (cookie). The code survives failed validations (so a typo in
-- the password doesn't lock you out) and burns only when setup succeeds.
export task setup_submit(body)
    when body == nothing
        give respond("body must be JSON: {\"name\", \"pass\", \"pass2\", \"code\"}", "text/plain", 400)
    when users_exist()
        give respond("setup already done — sign in at /login", "text/plain", 403)
    let stored be store.get("synfide-setup-code", nothing)
    when stored == nothing
        give respond("open /setup first — the setup code prints on the server terminal", "text/plain", 403)
    let sent be ""
    when contains(body, "code")
        set sent to text(body["code"])
    when not constant_time_eq(sent, stored)
        give respond("wrong setup code — it is printed on the SERVER terminal", "text/plain", 403)
    let u be nothing
    try
        set u to create_first_admin(body["name"], body["pass"], body["pass2"])
    recover err
        give respond(esc(err), "text/plain", 400)
    store.del("synfide-setup-code")
    let sid be session_start(u)
    give set_cookie({"ok": true, "name": u["name"]}, "sid", sid, {"max_age": SESS_TTL})

-- login_submit(body) → verifies and signs in (cookie). Wrong user and wrong
-- password are the same answer on purpose.
export task login_submit(body)
    when body == nothing
        give respond("body must be JSON: {\"name\", \"pass\"}", "text/plain", 400)
    let u be nothing
    try
        set u to login_check(body["name"], body["pass"])
    recover err
        give respond("account store problem — check the server log", "text/plain", 500)
    when u == nothing
        journal.record("auth", "auth-denied", "failed sign-in for " + esc(text(body["name"])))
        give respond("wrong username or password", "text/plain", 403)
    journal.record(u["name"], "auth-login", "signed in")
    let sid be session_start(u)
    give set_cookie({"ok": true, "name": u["name"]}, "sid", sid, {"max_age": SESS_TTL})

export task logout(request)
    session_end(cookie_sid(request))
    give clear_cookie(go("/login"), "sid")

-- ---------- upgrade leftovers ----------

-- upgrade_leftovers(dir = ".") → every *.new file the installer left in the
-- project root: a release changed a user file that had local edits, so the
-- user's copy was KEPT and the release's landed beside it as <file>.new.
-- Nothing announces those files otherwise — whoever doesn't know the
-- convention never learns there is something to merge, so the shell shows a
-- banner on every page until they're dealt with (merge, then delete the
-- .new). Needs the entry cap `require file.read(".")` — the directory NODE
-- only: names, never contents. Without it (older entries) the probe
-- degrades to "no leftovers" instead of erroring.
export task upgrade_leftovers(dir = ".")
    try
        let found be []
        each e in list_dir(dir)
            when not e["is_dir"]
                when ends_with(e["name"], ".new")
                    set found to found + [e["name"]]
        give found
    recover err
        give []

-- ---------- environment ----------

-- The probe is SEALED: secret(name) never lets the value into program space —
-- present/absent is all this page can ever know, let alone show. A denied
-- capability reads as its own state so a missing `require secret` in the
-- entry can't masquerade as "not set". THIRD state: the process env is frozen
-- at startup, so a value just saved to .env probes as absent until the server
-- restarts — without this state a successful save LOOKS like a failure.
task env_view(name)
    let state be "set"
    let cls be "st-done"
    let loaded be true
    try
        secret(name)
    recover err
        set loaded to false
        when contains(text(err), "apability")
            set state to "no access — add `require secret` to the entry"
            set cls to "st-waiting"
        otherwise
            set state to "not set"
            set cls to "st-failed"
    when loaded
        -- it made it into the process: the pending marker (if any) is done
        store.del("synfide-env-saved:" + name)
    otherwise
        when store.get("synfide-env-saved:" + name, nothing) != nothing
            set state to "saved to .env — restart the server to load it"
            set cls to "st-waiting"
    give {"name": name, "state": state, "cls": cls}

-- env_names_from_example(path) → every variable name documented in the given
-- .env.example (uncommented or commented-out lines alike), in file order,
-- deduped — so /admin/env shows THE WHOLE surface, not a hand-picked few.
-- Entry cap: `require file.read("./.env.example")`.
export task env_names_from_example(path)
    when not file_exists(path)
        give []
    let names be []
    let seen be {}
    each ln in split(read_file(path), "\n")
        let s be trim(ln)
        while starts_with(s, "#")
            set s to trim(slice(s, 1, length(s)))
        when contains(s, "=")
            let name be trim(split(s, "=")[0])
            when name != ""
                when not contains(name, " ")
                    when upper(name) == name
                        when not contains(seen, name)
                            set seen[name] to true
                            set names to names + [name]
    give names

-- env_page(names, editable) → configuration: presence always; editing is
-- WRITE-ONLY when `editable` (values are typed into a password field, travel
-- once to the server, and can never be read back — the page only ever knows
-- set / not set). Each write must carry a one-time code that the server
-- prints to ITS OWN TERMINAL: only the operator at the console can authorize
-- a change, and a cross-site request can never learn it. The ENTRY declares
-- `require secret` (+ `require random` and `require file("./.env")` when
-- editable) and wires:
--     route "GET /admin/env"        give html(ui.env_page(ENV_VARS, true))
--     route "POST /admin/env/code"  give ui.env_code_request()
--     route "POST /admin/env/set"   give ui.env_set(json of request, ENV_VARS, true)
export task env_page(names, editable)
    let d be shell_data("Synfide — environment", "env", "Environment", "", "")
    set d["vars"] to apply(names, (n) => env_view(n))
    set d["has_vars"] to length(names) > 0
    set d["editable"] to editable
    set d["names"] to names
    -- env_view just cleared the markers of anything already loaded — what
    -- remains is genuinely waiting for a restart
    let pending be length(store.list("synfide-env-saved:"))
    set d["has_pending"] to pending > 0
    set d["pending_n"] to pending
    give body of render("synfide/ui/pages/env.html", d)

-- env_code_request() → mints a one-time, short-lived code and prints it ONLY
-- to the server console (never in the HTTP response). Needs `require random`.
export task env_code_request()
    let code be text(random_int(100000, 999999))
    store.put("synfide-env-code", {"code": code, "at": now()})
    log "env edit code: " + code + "  (valid 10 minutes, single use)"
    give {"ok": true, "note": "code printed on the server terminal"}

task burn_env_code(code)
    let rec be store.get("synfide-env-code", nothing)
    when rec == nothing
        raise("no code requested — click \"Request code\" first, then read the server terminal")
    store.del("synfide-env-code")
    when now() - rec["at"] > 600
        raise("code expired — request a fresh one")
    when not constant_time_eq(text(code), rec["code"])
        raise("wrong code")
    give true

-- env_set(body, allowed, allow_new = false) → writes NAME=value into ./.env
-- (atomic; creates the file if absent; replaces the line if present). The
-- value is validated to a single line (a newline would smuggle extra
-- variables in) and the one-time code must match. The name must be in the
-- entry's allowed list — OR, when `allow_new` (the dispatcher passes
-- env_editable), any well-formed UPPER_SNAKE_CASE name: your Supabase, your
-- WABA, your custom API — the framework can't foresee them. Once saved it
-- lives in ./.env, which env_vars_all reads, so it keeps showing on the
-- page. The value is never echoed back, logged, or stored anywhere except
-- .env itself.
export task env_set(body, allowed, allow_new = false)
    when body == nothing
        give respond("body must be JSON: {\"name\", \"value\", \"code\"}", "text/plain", 400)
    let name be text(body["name"])
    when not contains(allowed, name)
        when not allow_new
            give respond("unknown variable: " + esc(name), "text/plain", 400)
        when not matches(name, "[A-Z][A-Z0-9_]{0,63}")
            give respond("new variable names are UPPER_SNAKE_CASE: A-Z, 0-9 and _, starting with a letter, 64 chars max", "text/plain", 400)
    let value be text(body["value"])
    when contains(value, "\n") or contains(value, "\r")
        give respond("value must be a single line", "text/plain", 400)
    when length(value) > 4096
        give respond("value too long", "text/plain", 400)
    try
        burn_env_code(body["code"])
    recover err
        give respond(esc(err), "text/plain", 403)
    let content be ""
    when file_exists("./.env")
        set content to read_file("./.env")
    let lines be split(content, "\n")
    let out be []
    let found be false
    let i be 0
    while i < length(lines)
        let ln be lines[i]
        when starts_with(ln, name + "=")
            when not found
                set out to out + [name + "=" + value]
                set found to true
        otherwise
            when trim(ln) != "" or i < length(lines) - 1
                set out to out + [ln]
        set i to i + 1
    when not found
        set out to out + [name + "=" + value]
    write_file("./.env", join(out, "\n") + "\n")
    journal.record("env-editor", "env-set", name + " (value sealed — written to .env)")
    -- the page shows this var as "saved — restart to load" until the process
    -- actually sees it (env_view clears the marker then)
    store.put("synfide-env-saved:" + name, {"at": now()})
    give {"ok": true, "name": name, "note": "saved to .env — restart the server to apply"}

-- ---------- endpoints ----------

-- endpoints_page(api_docs) → the curated API, inside the admin shell (the
-- sidebar link that used to jump to raw /llms.txt was a dead end). Each entry
-- is one "METHOD /path — what it does\n  curl ..." block. /llms.txt keeps
-- serving the same list as plain text for agents.
export task endpoints_page(api_docs)
    let d be shell_data("Synfide — endpoints", "endpoints", "Endpoints", "", "")
    set d["docs"] to api_docs
    set d["has_docs"] to length(api_docs) > 0
    give body of render("synfide/ui/pages/endpoints.html", d)

-- ---------- chat ----------
-- A chat over the runtime's configured LLM provider (any of them, or a local
-- GGUF — the framework never names one). History persists in the store;
-- offline it still works, answering with the runtime's placeholder and showing
-- a banner telling you to configure .env.

task chat_next_n()
    let n be store.get("synfide-chat-n", 0) + 1
    store.put("synfide-chat-n", n)
    give n

task chat_entries()
    let vals be apply(store.list("synfide-chat:"), (kv) => kv["value"])
    give sort_by(vals, (e) => e["n"])

task chat_record(role, content)
    let n be chat_next_n()
    store.put("synfide-chat:" + text(n), {"n": n, "role": role, "text": content})

task recent_ctx()
    let es be chat_entries()
    let maxn be length(es)
    let recent be where(es, (e) => e["n"] > maxn - 8)
    give join(apply(recent, (e) => e["role"] + ": " + e["text"]), "\n")

-- chat_send(message) → answers with the configured provider (recent turns as
-- context), persists both sides, and redirects back to /chat.
export task chat_send(message)
    when message == nothing or trim(text(message)) == ""
        give go("/chat")
    let msg be trim(text(message))
    chat_record("user", msg)
    let answer be reason about msg with context = recent_ctx()
    chat_record("assistant", text(answer))
    give go("/chat")

-- chat_send_with(message, responder) → same, but the answer comes from YOUR
-- responder task — typically an agent with tools (see synfide/agent.syn):
--     task my_agent(message, history)
--         give agent.respond(message, tools, catalog, history, 4)
--     route "GET /chat/send"
--         give ui.chat_send_with(query.message, my_agent)
export task chat_send_with(message, responder)
    when message == nothing or trim(text(message)) == ""
        give go("/chat")
    let msg be trim(text(message))
    chat_record("user", msg)
    let answer be call(responder, {"message": msg, "history": recent_ctx()})
    chat_record("assistant", text(answer))
    give go("/chat")

-- chat_page() → the chat as HTML text (wrap with html() in your route).
export task chat_page()
    let es be chat_entries()
    let d be shell_data("Synfide — chat", "chat", "Chat", "", "1")
    set d["show_banner"] to not llm_available()
    set d["messages"] to es
    set d["has_msgs"] to length(es) > 0
    give body of render("synfide/ui/pages/chat.html", d)

-- ---------- the admin dispatcher: the WHOLE framework surface, framework-owned ----------
-- The boundary fix (DESIGN-frontera-framework-usuario): the user's entry stops
-- carrying framework wiring. THREE routes serve everything — present and
-- future — so a framework release never needs to touch the user's file again:
--
--     route "GET /"           give ui.admin_get("", request, query, CONFIG)
--     route "GET /*path"      give ui.admin_get(params.path, request, query, CONFIG)
--     route "POST /*path"     give ui.admin_post(params.path, request, CONFIG)
--
-- Route precedence is by SPECIFICITY, so the user's own routes always win over
-- the catch-alls. Unknown paths → 404 here, like any server.
--
-- CONFIG is the user's policy, all keys optional:
--   "responder"    task(message, history) → the chat agent (absent → plain LLM chat)
--   "env_vars"     extra variable names for /admin/env (unioned with the rest)
--   "env_editable" bool — enable the write-only .env editor (needs random + file("./.env"))
--   "api_docs"     list of endpoint doc strings (endpoints page + /llms.txt)
--   "about"        one line describing the app (llms.txt title)
--   "open"         bool — DEMO MODE: no login, everything public. For local
--                  examples only; never ship an app with it.

-- Variables the framework knows about at THIS release — framework-owned, so it
-- updates with the framework instead of rotting in the user's entry.
let KNOWN_VARS be ["SYNSEMA_LLM_PROVIDER", "ANTHROPIC_API_KEY", "OPENAI_API_KEY", "MINIMAX_API_KEY", "DEEPSEEK_API_KEY", "SYNSEMA_LLM_MODEL", "SYNSEMA_LLM_MAX_TOKENS", "SYNSEMA_LLM_TIMEOUT", "SYNSEMA_LLM_HTTP_STREAM", "SYNSEMA_LLM_BASE_URL", "SYNSEMA_LLM_BUDGET", "SYNSEMA_SPEND_CEILING", "SYNSEMA_SPEND_CEILING_PER_IDENTITY", "SYNSEMA_SIGN_CEILING", "SYNSEMA_HUMAN_TIMEOUT", "SYNSEMA_HUMAN_WEBHOOK", "SYNSEMA_HUMAN_WEBHOOK_SECRET", "SYNSEMA_HUMAN_PUBLIC_URL", "JWT_KEY", "CAPTOKEN_ROOT_KEY", "AGENT_SIGNING_KEY", "SYNFIDE_ADMIN_TOKEN"]

task cfg_get(cfg, key, fallback)
    when cfg == nothing
        give fallback
    when contains(cfg, key)
        give cfg[key]
    give fallback

-- Names already living in ./.env — so a custom variable saved from the
-- dashboard (or hand-added to the file) keeps showing on /admin/env after
-- the save. Reading ./.env takes the entry's `file("./.env")` cap, which
-- only editable entries declare: absent, this source degrades to empty.
task env_names_from_env_file()
    try
        give env_names_from_example("./.env")
    recover err
        give []

-- The /admin/env list = UNION of ./.env.example (primary, dynamic), ./.env
-- itself (custom variables live only there), the names known at this release
-- (floor for stale examples), and the entry's extras.
export task env_vars_all(extra)
    let names be env_names_from_example("./.env.example")
    each ev in env_names_from_env_file()
        when not contains(names, ev)
            set names to names + [ev]
    each kv in KNOWN_VARS
        when not contains(names, kv)
            set names to names + [kv]
    each xv in extra
        when not contains(names, xv)
            set names to names + [xv]
    give names

-- llms_txt(cfg) → the curated, usable API as plain text for agents (browser
-- pages deliberately not listed).
export task llms_txt(cfg)
    let t be "# " + text(cfg_get(cfg, "about", "Synfide app")) + "\n\n"
    set t to t + "> The human surfaces (/, /chat, /inbox/ui, /admin/*) are browser pages — not listed here.\n\n"
    let docs be cfg_get(cfg, "api_docs", [])
    when length(docs) == 0
        set t to t + "## API\n(none documented yet — fill CONFIG.api_docs in the entry)\n"
    otherwise
        set t to t + "## API\n- " + join(docs, "\n- ") + "\n"
    give respond(t, "text/plain")

-- Bearer from the Authorization header ("Bearer x" → "x"), or nothing.
task bearer_token(request)
    when not contains(request, "headers")
        give nothing
    let hs be request["headers"]
    when not contains(hs, "authorization")
        give nothing
    let h be text(hs["authorization"])
    when starts_with(h, "Bearer ")
        give slice(h, 7, length(h))
    when starts_with(h, "bearer ")
        give slice(h, 7, length(h))
    give nothing

-- api_or_session_guard(request) → nothing when the caller is a signed-in
-- human OR presents the admin bearer; else the 401 to give.
task api_or_session_guard(request)
    let u be authenticate(bearer_token(request), request)
    when u == nothing
        give respond("sign in, or present Authorization: Bearer <SYNFIDE_ADMIN_TOKEN>", "text/plain", 401)
    give nothing

-- The UI's own assets, served BY the dispatcher: a `static` mount can't work
-- here because the `GET /*path` catch-all matches every path first (declared
-- routes beat static in the engine). Whitelisted by exact name — no
-- traversal surface — and public: the login page needs its stylesheet.
-- The ENTRY declares `require file.read("./synfide/ui/static/*")`.
task ui_asset(name)
    when name == "synfide.css"
        give with_header(respond(read_file("./synfide/ui/static/synfide.css"), "text/css"), "Cache-Control", "max-age=300")
    when name == "synfide.js"
        give with_header(respond(read_file("./synfide/ui/static/synfide.js"), "text/javascript"), "Cache-Control", "max-age=300")
    give not_found("no such asset: " + esc(name))

-- admin_get(path, request, query, cfg) → the full GET surface.
export task admin_get(path, request, query, cfg)
    let p be text(path)
    let open be cfg_get(cfg, "open", false)
    -- reachable without a session
    when starts_with(p, "synfide-ui/")
        give ui_asset(slice(p, 11, length(p)))
    when p == "setup"
        when open
            give go("/")
        when users_exist()
            give go("/login")
        give html(setup_page())
    when p == "login"
        when open
            give go("/")
        give html(login_page())
    when p == "logout"
        when open
            give go("/")
        give logout(request)
    when p == "llms.txt"
        give llms_txt(cfg)
    -- JSON API: session OR bearer
    when p == "inbox"
        when not open
            let ga be api_or_session_guard(request)
            when ga != nothing
                give ga
        give approvals.pending()
    -- browser pages: session required
    when not open
        let g be guard(request)
        when g != nothing
            give g
    when p == ""
        give html(home_page())
    when p == "chat"
        give html(chat_page())
    when p == "chat/send"
        let responder be cfg_get(cfg, "responder", nothing)
        when responder == nothing
            give chat_send(query.message)
        give chat_send_with(query.message, responder)
    when p == "inbox/ui"
        give html(inbox_page())
    when p == "admin/workflows"
        give html(workflows_page())
    when p == "admin/journal"
        give html(journal_page())
    when p == "admin/patches"
        give html(patches_page())
    when starts_with(p, "admin/patches/")
        give html(patch_page(slice(p, 14, length(p))))
    when p == "admin/env"
        give html(env_page(env_vars_all(cfg_get(cfg, "env_vars", [])), cfg_get(cfg, "env_editable", false)))
    when p == "admin/endpoints"
        give html(endpoints_page(cfg_get(cfg, "api_docs", [])))
    give not_found("no such page: " + esc(p))

-- admin_post(path, request, cfg) → the full POST surface.
export task admin_post(path, request, cfg)
    let p be text(path)
    let open be cfg_get(cfg, "open", false)
    when p == "setup/submit"
        give setup_submit(request.json)
    when p == "login/submit"
        give login_submit(request.json)
    -- JSON API: session OR bearer (scripts, bots, other services)
    when starts_with(p, "inbox/")
        when p != "inbox/ui/decide"
            when not open
                let ga be api_or_session_guard(request)
                when ga != nothing
                    give ga
            let b be request.json
            when b == nothing
                give respond("body must be JSON: {\"approved\": true|false, \"who\": \"name\"}", "text/plain", 400)
            let id be slice(p, 6, length(p))
            let d be approvals.resolve(id, b["approved"] == true, text(b["who"]))
            when d == nothing
                give not_found("no such approval: " + esc(id))
            give d
    -- browser JSON: session required
    when not open
        let g be guard_api(request)
        when g != nothing
            give g
    when p == "inbox/ui/decide"
        give resolve_json(request.json)
    when p == "admin/env/code"
        give env_code_request()
    when p == "admin/env/set"
        give env_set(request.json, env_vars_all(cfg_get(cfg, "env_vars", [])), cfg_get(cfg, "env_editable", false))
    give not_found("no such action: " + esc(p))

-- ---------- decisions ----------

-- resolve_json(body) → records a decision arriving as JSON ({id, approved,
-- who}) — the inbox buttons post THIS way (a cross-site form can't: JSON
-- posts trigger a preflight and the SameSite=Lax cookie stays home). Wire it
-- at POST /inbox/ui/decide behind guard_api.
export task resolve_json(body)
    when body == nothing
        give respond("body must be JSON: {\"id\", \"approved\", \"who\"}", "text/plain", 400)
    let who be text(body["who"])
    when trim(who) == ""
        set who to "web"
    let d be nothing
    try
        set d to approvals.resolve(text(body["id"]), body["approved"] == true, who)
    recover err
        -- Protected approval: the one-time code (sent through YOUR channel) is
        -- the authorization — the plain inbox button politely refuses.
        give respond(esc(err), "text/plain", 403)
    when d == nothing
        give respond("unknown approval: " + esc(text(body["id"])), "text/plain", 404)
    journal.record(who, "ui-decision", text(body["id"]) + " -> " + d["status"])
    give {"ok": true, "status": d["status"]}

-- resolve(id, approved_text, who_text) → the GET-form variant (no-JS). Kept
-- for compatibility; prefer resolve_json for session-cookie deployments (a
-- top-level GET navigation does carry a Lax cookie).
export task resolve(id, approved_text, who_text)
    let who be who_text
    when who == "" or who == nothing
        set who to "web"
    let d be nothing
    try
        set d to approvals.resolve(id, approved_text == "yes", who)
    recover err
        -- Protected approval: the one-time code (sent through YOUR channel) is
        -- the authorization — the plain inbox button politely refuses.
        give respond(esc(err), "text/plain", 403)
    when d == nothing
        give respond("unknown approval: " + esc(id), "text/plain", 404)
    journal.record(who, "ui-decision", id + " -> " + d["status"])
    give go("/inbox/ui")
