-- Synfide test suite. Run with FRESH state and audit dirs so tests are
-- deterministic and never touch your real audit logs:
--
--   SYNSEMA_STATE_DIR=$(mktemp -d) SYNSEMA_AUDIT_DIR=$(mktemp -d) synsema test test_synfide.syn
--
intent: "Prove store, durable re-entry, approvals, treasury, cassettes and journal"

require memory("synfide-tests")
require time
require spend("T_*")

use "./synfide/store.syn" as store
use "./synfide/durable.syn" as durable
use "./synfide/approvals.syn" as approvals
use "./synfide/treasury.syn" as treasury
use "./synfide/cassettes.syn" as cassettes
use "./synfide/journal.syn" as journal
use "./synfide/ui.syn" as ui
use "./synfide/agent.syn" as agent

-- ---------- store ----------

test "store: put/get round-trips any JSON value and upserts"
    store.put("t1:user", {"name": "ana", "n": 3})
    assert_eq(store.get("t1:user", nothing), {"name": "ana", "n": 3})
    store.put("t1:user", {"name": "ana", "n": 4})
    assert_eq(store.get("t1:user", nothing)["n"], 4)

test "store: get falls back, del removes, list filters by prefix"
    assert_eq(store.get("t2:absent", "fallback"), "fallback")
    store.put("t2:a", 1)
    store.put("t2:b", 2)
    store.put("other:c", 3)
    assert_eq(length(store.list("t2:")), 2)
    assert_eq(store.del("t2:a"), 1)
    assert_eq(length(store.list("t2:")), 1)

-- ---------- durable ----------

task s_one(ctx)
    give 10

task s_two(ctx)
    give ctx["one"] + 5

task happy_steps()
    give [{"name": "one", "run": s_one}, {"name": "two", "run": s_two}]

test "durable: happy path completes and threads results through ctx"
    let r be durable.run("t-happy", happy_steps(), {"seed": true})
    assert_eq(r["status"], "done")
    assert_eq(r["ctx"]["one"], 10)
    assert_eq(r["ctx"]["two"], 15)

task s_parks(ctx)
    give durable.wait("external world pending")

test "durable: a waiting step parks the workflow and re-entry retries it"
    let steps be [{"name": "park", "run": s_parks}]
    let r1 be durable.run("t-park", steps, {})
    assert_eq(r1["status"], "waiting")
    assert_eq(r1["step"], "park")
    let r2 be durable.run("t-park", steps, {})
    assert_eq(r2["status"], "waiting", "still parked until the world acts")

task s_boom(ctx)
    when store.get("t-fixed", nothing) == nothing
        raise("boom")
    give "recovered"

test "durable: a failed step is retried on the next run, completed steps are not re-run"
    let steps be [{"name": "one", "run": s_one}, {"name": "boom", "run": s_boom}]
    let r1 be durable.run("t-retry", steps, {})
    assert_eq(r1["status"], "failed")
    assert_eq(r1["step"], "boom")
    store.put("t-fixed", true)
    let r2 be durable.run("t-retry", steps, {})
    assert_eq(r2["status"], "done")
    assert_eq(r2["ctx"]["one"], 10, "step one ran in run 1 and was skipped in run 2")
    assert_eq(r2["ctx"]["boom"], "recovered")

-- ---------- approvals ----------

test "approvals: request is idempotent, decide flips status, pending filters"
    let a1 be approvals.request("ap-1", "ok to ship?")
    assert_eq(a1["status"], "pending")
    let a2 be approvals.request("ap-1", "DIFFERENT message must not overwrite")
    assert_eq(a2["message"], "ok to ship?")
    assert_eq(length(approvals.pending()), 1)
    let d be approvals.resolve("ap-1", true, "joel")
    assert_eq(d["status"], "approved")
    assert_eq(d["decided_by"], "joel")
    assert_eq(length(approvals.pending()), 0)
    assert_eq(approvals.resolve("ap-unknown", true, "joel"), nothing)

task s_gate(ctx)
    give approvals.gate("ap-flow", "gate?")

test "approvals + durable: gate parks, approval lets it through"
    let steps be [{"name": "gate", "run": s_gate}]
    let r1 be durable.run("t-gate", steps, {})
    assert_eq(r1["status"], "waiting")
    approvals.resolve("ap-flow", true, "joel")
    let r2 be durable.run("t-gate", steps, {})
    assert_eq(r2["status"], "done")
    assert_eq(r2["ctx"]["gate"]["status"], "approved")

-- ---------- registry + tick ----------

test "registry: workflows(prefix) reports each workflow's last status"
    durable.run("reg-a", happy_steps(), {})
    let steps be [{"name": "park", "run": s_parks}]
    durable.run("reg-b", steps, {})
    let regs be durable.workflows("reg-")
    assert_eq(length(regs), 2)
    let done be where(regs, (w) => w["status"] == "done")
    let waiting be where(regs, (w) => w["status"] == "waiting")
    assert_eq(length(done), 1)
    assert_eq(done[0]["name"], "reg-a")
    assert_eq(waiting[0]["step"], "park")
    assert_eq(length(durable.workflows("otra-cosa")), 0)

task s_tick_gate(ctx)
    give approvals.gate("ap-tick", "tick gate?")

test "tick: re-runs only the waiting workflows of the matching prefix"
    let steps be [{"name": "gate", "run": s_tick_gate}]
    durable.run("tk-1", steps, {})
    let defs be [{"prefix": "tk-", "steps": steps}]
    -- still pending → the tick re-runs it but it parks again
    let w1 be durable.tick(defs)
    assert_eq(length(w1), 1)
    assert_eq(w1[0]["status"], "waiting")
    -- approval lands → the NEXT tick finishes it, no manual run() needed
    approvals.resolve("ap-tick", true, "joel")
    let w2 be durable.tick(defs)
    assert_eq(w2, [{"name": "tk-1", "status": "done"}])
    -- done workflows are not ticked again
    assert_eq(durable.tick(defs), [])

task s_gate_denied(ctx)
    give approvals.gate("ap-denied", "gate?")

test "approvals + durable: a denial fails the step (recorded, retryable)"
    let steps be [{"name": "gate", "run": s_gate_denied}]
    let r1 be durable.run("t-denied", steps, {})
    assert_eq(r1["status"], "waiting")
    approvals.resolve("ap-denied", false, "joel")
    let r2 be durable.run("t-denied", steps, {})
    assert_eq(r2["status"], "failed")
    assert(contains(r2["error"], "denied by joel"))

-- ---------- treasury ----------

task mock_pay(amount, unit, why)
    give "receipt-" + text(amount) + "-" + unit

task failing_pay(amount, unit, why)
    raise("PSP timeout")

test "treasury: pay checks the scope budget, declares the spend, and records"
    treasury.set_budget("mkt", "T_USD", 100)
    let r be treasury.pay("mkt", 60, "T_USD", "campaign", mock_pay)
    assert_eq(r["ok"], true)
    assert_eq(r["receipt"], "receipt-60-T_USD")
    assert_eq(r["scope_spent"], 60)
    assert_eq(treasury.budget_left("mkt", "T_USD"), 40)
    assert_eq(spend_total("T_USD"), 60, "el ledger del runtime tambien lo vio")

test "treasury: the policy cut happens BEFORE anything is declared or moved"
    let before be spend_total("T_USD")
    let msg be ""
    try
        treasury.pay("mkt", 50, "T_USD", "over budget", mock_pay)
    recover err
        set msg to err
    assert(contains(msg, "budget exceeded"))
    assert_eq(spend_total("T_USD"), before, "nada llego al ledger del runtime")
    assert_eq(treasury.spent("mkt", "T_USD"), 60, "el scope no crecio")

test "treasury: a payment that fails AFTER the spend is a recorded discrepancy"
    let before be spend_total("T_USD")
    let msg be ""
    try
        treasury.pay("ops", 25, "T_USD", "flaky psp", failing_pay)
    recover err
        set msg to err
    assert(contains(msg, "AFTER the spend was declared"))
    assert_eq(spend_total("T_USD"), before + 25, "el ledger declara ANTES: sobre-cuenta honesta")
    assert_eq(treasury.spent("ops", "T_USD"), 0, "el scope NO registra un pago que no ocurrio")
    assert_eq(length(treasury.discrepancies()), 1)
    assert(contains(treasury.discrepancies()[0]["error"], "PSP timeout"))

test "treasury: a scope without budget only rides the runtime ledger"
    let r be treasury.pay("free", 5, "T_USD", "no policy", mock_pay)
    assert_eq(r["ok"], true)
    assert_eq(treasury.budget_left("free", "T_USD"), nothing)

-- ---------- cassettes ----------

test "cassettes: record then replay — the replay needs no provider at all"
    let a1 be cassettes.ask("record", "what is the capital of france")
    let a2 be cassettes.ask("replay", "what is the capital of france")
    assert_eq(a1, a2)
    assert_eq(length(cassettes.recorded()), 1)

test "cassettes: replay without a recording raises (never silently hits the network)"
    let msg be ""
    try
        cassettes.ask("replay", "never recorded prompt")
    recover err
        set msg to err
    assert(contains(msg, "no recording"))
    assert_eq(cassettes.forget("what is the capital of france"), 1)
    assert_eq(length(cassettes.recorded()), 0)

-- ---------- journal ----------

task tool_hello(name)
    give "hello " + name

task tool_boom()
    raise("tool exploded")

test "journal: dispatch journals ok, rejected and error — in order, nothing swallowed"
    let tools be {"hello": tool_hello, "boom": tool_boom}
    assert_eq(journal.dispatch(tools, "hello", {"name": "ana"}, "agent-1"), "hello ana")
    let m1 be ""
    try
        journal.dispatch(tools, "hacked_tool", {}, "agent-1")
    recover err
        set m1 to err
    assert(contains(m1, "not in allow-list"))
    let m2 be ""
    try
        journal.dispatch(tools, "boom", {}, "agent-1")
    recover err
        set m2 to err
    assert(contains(m2, "tool exploded"))
    let es be journal.entries()
    assert_eq(length(es), 3)
    assert_eq(apply(es, (e) => e["action"]), ["tool-ok", "tool-rejected", "tool-error"])
    assert_eq(es[0]["n"], 1)
    assert_eq(es[2]["actor"], "agent-1")

-- ---------- ui ----------

test "ui: the inbox page escapes user text — injected markup lands as text"
    approvals.request("xss-probe", "<script>alert(1)</script> & \"quotes\"")
    let page be ui.inbox_page()
    assert(contains(page, "&lt;script&gt;alert(1)&lt;/script&gt;"))
    assert(not contains(page, "<script>alert(1)"))
    assert(contains(page, "&amp; &quot;quotes&quot;"))
    assert(contains(page, "xss-probe"))
    assert(contains(page, "/inbox/ui/decide"), "el form apunta a la ruta de decision")

test "ui: decide resolves, journals, and redirects back to the inbox"
    approvals.request("ui-1", "ship the ui?")
    ui.resolve("ui-1", "yes", "")
    assert_eq(approvals.status("ui-1")["status"], "approved")
    assert_eq(approvals.status("ui-1")["decided_by"], "web", "quien vacio cae a \"web\"")
    let acts be apply(journal.entries(), (e) => e["action"])
    assert(contains(acts, "ui-decision"))

-- ---------- chat ----------

test "chat: send records both sides and the page renders them escaped"
    ui.chat_send("hola <b>mundo</b>")
    let page be ui.chat_page()
    assert(contains(page, "hola &lt;b&gt;mundo&lt;/b&gt;"), "el mensaje del usuario, escapado")
    assert(not contains(page, "<b>mundo</b>"))
    assert(contains(page, "assistant"), "hay respuesta del asistente (offline = placeholder)")
    assert(contains(page, "/chat/send"), "el form apunta a la ruta de envio")

test "chat: an empty message is a no-op redirect, history intact"
    ui.chat_send("")
    ui.chat_send(nothing)
    let page be ui.chat_page()
    assert(contains(page, "hola &lt;b&gt;mundo&lt;/b&gt;"), "la historia sigue")

-- ---------- agent ----------

task fake_responder(message, history)
    give "eco: " + message + " (con " + text(length(history)) + " chars de historia)"

test "agent: offline the loop degrades to the runtime placeholder, never crashes"
    let tools be {}
    let out be agent.respond("do something", tools, [], "", 3)
    assert(contains(out, "no llm provider"), "offline → placeholder del runtime: " + out)

test "chat_send_with: the answer comes from YOUR responder"
    ui.chat_send_with("probando al agente", fake_responder)
    let page be ui.chat_page()
    assert(contains(page, "eco: probando al agente"))
